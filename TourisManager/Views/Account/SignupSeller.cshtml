@model TourisManager.Models.ViewModels.SellerSignupViewModel
@{
    ViewData["Title"] = "Đăng ký Chủ quán";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-5">
                    <h3 class="text-center fw-bold text-success mb-4">Đăng Ký Trở Thành Đối Tác</h3>
                    <p class="text-center text-muted mb-4">Đưa quán ăn của bạn tiếp cận hàng ngàn thực khách trên hệ thống TourisManager</p>
                    
                    @if (TempData["Msg"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Msg"]</div>
                    }

                   <form asp-controller="Account" asp-action="SignupSeller" method="post">
                        <!-- Thông tin chủ quán -->
                        <h6 class="fw-bold mb-3 border-bottom pb-2">1. Thông tin tài khoản</h6>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và Tên</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên của bạn" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control" placeholder="Ví dụ: ngyuenvana" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email liên hệ</label>
                                <input asp-for="Email" class="form-control" placeholder="email@domain.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mật khẩu</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Ít nhất 6 ký tự" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Thông tin quán -->
                        <h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">2. Thông tin Gian hàng</h6>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Tên quán ăn / Thương hiệu</label>
                            <input asp-for="ShopName" class="form-control form-control-lg border-success" placeholder="Ví dụ: Phở Gánh Hà Nội" />
                            <span asp-validation-for="ShopName" class="text-danger small"></span>
                            <div class="form-text text-muted small mt-1">Tên này sẽ hiển thị trực tiếp trên bản đồ và ứng dụng.</div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-bold py-2">Đăng ký gian hàng</button>
                    </form>
                    
                    <div class="text-center mt-4">
                        <span class="text-muted">Đã có tài khoản đối tác? </span>
                        <a href="/Account/Login" class="text-success fw-bold text-decoration-none">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}