@model TourisManager.Core.Entities.Account

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info me-3 alert-dismissible fade show" role="alert">
        @TempData["Msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section style="background-color: #eee;">
    <div class="container py-5">
        <div class="row">
            <!-- CỘT 1: AVATAR & THÔNG TIN CƠ BẢN  -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <!-- Ảnh xem trước Avatar (Xử lý fallback ảnh mặc định nếu chưa có) -->
                        <img id="avatarPreview"
                             src="@(string.IsNullOrEmpty(Model?.AvataUrl) ? "/Image/Upload/avatadefault.jpg" : Model.AvataUrl)"
                             alt="Avatar"
                             class="rounded-circle img-fluid mb-3"
                             style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #198754;">

                        <h5 class="my-2">@Model?.Name</h5>
                        <p class="text-muted mb-1">@Model?.Username</p>
                        <p class="text-muted mb-3">
                            <span class="badge bg-success">@Model?.Role</span>
                        </p>

                        <!-- Ô chọn file tự tải qua AJAX -->
                        <div class="mb-3">
                            <label for="avatarFile" class="form-label btn btn-outline-success btn-sm w-100">
                                <i class="bi bi-camera me-1"></i> Chọn ảnh Avatar mới
                            </label>
                            <input type="file" id="avatarFile" name="avatarFile" class="d-none" accept="image/*" onchange="uploadAvatarAjax(this)">
                            <div id="uploadStatus" class="small text-muted mt-1"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT 2-->
            <div class="col-lg-8">
                <form asp-controller="Account" asp-action="Profile" method="post" class="mb-4">
                    @Html.AntiForgeryToken()

                    <div class="card mb-4">
                        <div class="card-body">
                            <!-- Sửa Full Name -->
                            <div class="row mb-3">
                                <div class="col-sm-3 d-flex align-items-center">
                                    <label asp-for="Name" class="mb-0 fw-bold">Full Name</label>
                                </div>
                                <div class="col-sm-9">
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            <hr>

                            <!-- Email  -->
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0 fw-bold">Email</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">@Model?.Email</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nút Submit chỉ xử lý lưu Full Name -->
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save me-1"></i> Lưu Chỉnh sửa
                    </button>
                </form>

                <!-- FORM LOGOUT TÁCH RIÊNG HOÀN TOÀN -->
                <div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/js/Accounts/Profile.js" asp-append-version="true"></script>
}