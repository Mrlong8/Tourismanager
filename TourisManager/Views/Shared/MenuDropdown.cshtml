<div class="dropdown">
    <!-- Nút bấm hiển thị màu xanh lá chuyển tiếp Gradient -->
    <button class="btn btn-account-dropdown dropdown-toggle d-flex align-items-center gap-2 px-3 py-1 rounded-pill fw-semibold shadow-sm" 
            type="button" 
            id="userMenuDropdown" 
            data-bs-toggle="dropdown" 
            aria-expanded="false">
        <i class="bi bi-person-circle fs-5"></i>
        <span>@(User.Identity?.Name ?? "Account")</span>
    </button>

    <!-- Menu xổ xuống màu trắng (Light Theme) -->
    <ul class="dropdown-menu dropdown-menu-end custom-dropdown-menu shadow-lg border-0 mt-2" 
        aria-labelledby="userMenuDropdown">

        <!-- THÊM DÒNG NÀY ĐỂ VÀO TRANG ADMIN -->
        @if (User.IsInRole("Admin") || User.Identity.IsAuthenticated)
        {
             <a class="dropdown-item" asp-area="Admin" asp-controller="Admin" asp-action="Index">
             <i class="bi bi-speedometer2 me-2"></i>Trang quản lý
             </a>
          
        }
        <!-- Trang cá nhân -->
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                <i class="bi bi-person-vcard text-success"></i>
                <span>Trang cá nhân</span>
            </a>
        </li>

        <!-- Quản lý địa điểm (Trực tiếp) -->
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                <i class="bi bi-gear text-secondary"></i>
                <span>Cài đặt tài khoản</span>
            </a>
        </li>

        <li><hr class="dropdown-divider my-1 border-light-subtle"></li>

        <!-- Đăng xuất -->
        <li>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 w-100 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </li>
    </ul>
</div>