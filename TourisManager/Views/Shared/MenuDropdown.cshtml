<div class="dropdown">
    <!-- Nút bấm màu cam Shopee (Góc vuông, không bóng) -->
    <button class="btn btn-account-dropdown dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 fw-semibold"
            type="button"
            id="userMenuDropdown"
            data-bs-toggle="dropdown"
            data-bs-display="static"
            data-bs-auto-close="true"
            aria-expanded="false">
        <i class="bi bi-person-circle fs-5"></i>
        <span>@(User.Identity?.Name ?? "Account")</span>
    </button>

    <!-- Menu xổ xuống màu trắng (Góc vuông, viền mỏng) -->
    <ul class="dropdown-menu dropdown-menu-end custom-dropdown-menu mt-0"
        aria-labelledby="userMenuDropdown">

        <!-- MỤC DÀNH CHO ADMIN -->
        @if (User.IsInRole("Admin"))
        {
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 fw-semibold"
                   asp-area="Admin" asp-controller="Admin" asp-action="Index" style="color: var(--shopee-orange);">
                    <i class="bi bi-speedometer2"></i>
                    <span>Trang quản lý Admin</span>
                </a>
            </li>
            <li><hr class="dropdown-divider m-0 border-light-subtle"></li>
        }
         @if (User.IsInRole("Seller"))
        {
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 fw-semibold"
                   asp-area="Seller" asp-controller="Dashboard" asp-action="Index" style="color: var(--shopee-orange);">
                    <i class="bi bi-speedometer2"></i>
                    <span>Quản lý cửa hàng</span>
                </a>
            </li>
            <li><hr class="dropdown-divider m-0 border-light-subtle"></li>
        }

        <!-- MỤC DÀNH CHO SELLER -->
        @if (User.IsInRole("Seller"))
        {
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 fw-semibold text-success"
                   asp-area="Seller" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-shop"></i>
                    <span>Kênh Chủ Quán</span>
                </a>
            </li>
            <li><hr class="dropdown-divider m-0 border-light-subtle"></li>
        }

        <!-- Trang cá nhân -->
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                <i class="bi bi-person-vcard"></i>
                <span>Trang cá nhân</span>
            </a>
        </li>

       

        <!-- đơn hầng -->
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="MyOrder">
                <i class="bi bi-receipt"></i>
                <span>Đơn hàng</span>
            </a>
        </li>
         <!-- giỏ hàng -->
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="MyCart">
               <i class="bi bi-cart-fill"></i>
                <span>Giỏ Hàng</span>
            </a>
        </li>
         <!-- ví -->
        
           <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Wallet" asp-action="Index">
               <i class="bi bi-wallet2"></i>
                <span>Ví</span>
            </a>
        </li>

         <!-- Đổi mật khẩu / Cài đặt tài khoản -->
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="ChangePassword">
                <i class="bi bi-shield-lock"></i>
                <span>Đổi mật khẩu</span>
            </a>
        </li>

        <li><hr class="dropdown-divider m-0 border-light-subtle"></li>

        <!-- Nút Đăng xuất an toàn -->
        <li>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 w-100 border-0 bg-transparent py-2">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="fw-semibold">Đăng xuất</span>
                </button>
            </form>
        </li>
    </ul>
</div>