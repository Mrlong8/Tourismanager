<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TourisManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/TopNav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Account/Login.css"  />
    <link rel="stylesheet" href="~/css/Account/signup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Location.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/User.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/MenuDropdown.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/FloatingChat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/Footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- header (top nav) -->
    <partial name="TopNav"/>

    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>



    @* footer *@
    <partial name="Footer" />

    @* Floating Chat*@
    <partial name="_FloatingChat" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   <script src="~/js/Shared/floating-chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
