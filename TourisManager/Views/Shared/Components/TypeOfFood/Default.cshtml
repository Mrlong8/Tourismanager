@model IEnumerable<TourisManager.Core.Entities.TypeFood>

<style>
    /* Nút danh mục loại món ăn */
    .btn-food-category {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        color: #374151;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
        text-decoration: none;
    }

    .btn-food-category i {
        color: #f97316; /* Màu cam Shopee/SuperFood */
        font-size: 1.05rem;
        transition: color 0.2s ease-in-out;
    }

    /* Hiệu ứng rê chuột (Hover) */
    .btn-food-category:hover {
        background-color: #fff7ed;
        border-color: #fdba74;
        color: #ea580c;
    }

    .btn-food-category:hover i {
        color: #ea580c;
    }

    /* Trạng thái đang chọn (Active) - nền cam chữ trắng đồng bộ SuperFood */
    .btn-food-category.active {
        background-color: #f97316 !important;
        border-color: #f97316 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
    }

    .btn-food-category.active i {
        color: #ffffff !important;
    }
</style>

<div class="d-flex flex-column gap-2">
    <!-- Nút "Tất cả" dạng nút nổi bật mặc định màu cam ban đầu -->
    <a href="javascript:void(0);"
       data-id=""
       class="btn-category-filter btn-food-category active btn text-start rounded-2 d-flex align-items-center px-3 py-2 shadow-sm">
        <i class="bi bi-grid-fill me-2"></i>
        <span>Tất cả</span>
    </a>

    @if (Model != null)
    {
        foreach (var type in Model)
        {
            <a href="javascript:void(0);"
               data-id="@type.TypeFoodId"
               class="btn-category-filter btn-food-category btn text-start rounded-2 d-flex align-items-center px-3 py-2 shadow-sm">
                <i class="bi bi-cup-hot me-2"></i>
                <span>@type.Name</span>
            </a>
        }
    }
</div>
