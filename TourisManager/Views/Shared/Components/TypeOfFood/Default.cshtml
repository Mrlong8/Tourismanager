@model IEnumerable<TourisManager.Core.Entities.TypeFood>

<div class="food-categories-scroll-wrapper">
    <!-- Nút "Tất cả" dạng thẻ pill -->
    <button type="button"
            data-id=""
            class="btn-food-filter-chip active">
        <i class="bi bi-grid-fill me-1"></i>
        <span>Tất cả</span>
    </button>

    @if (Model != null)
    {
        foreach (var type in Model)
        {
            <button type="button"
                    data-id="@type.TypeFoodId"
                    class="btn-food-filter-chip">
                <i class="bi bi-cup-hot me-1"></i>
                <span>@type.Name</span>
            </button>
        }
    }
</div>
