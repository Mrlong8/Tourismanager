@{
    // Lồng vào MyLayout (chứa TopNav & Footer)
    Layout = "MyLayout";
}

<link rel="stylesheet" href="~/css/Food/_FoodGirdPartial.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Food/_LayoutFood.css" asp-append-version="true" />

<div class="food-page-wrapper">
    <!-- CỘT TRÁI: KHUNG LỌC LOẠI MÓN ĂN (CỐ ĐỊNH, CUỘN DỌC TỰ NHIÊN) -->
    <aside class="food-sidebar-filter">
        <!-- Header bộ lọc -->
        <div class="food-filter-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel-fill text-orange"></i>
                <span class="fw-bold text-uppercase fs-7 text-dark">Phân loại món</span>
            </div>
            <!-- Nút xóa nhanh tất cả bộ lọc -->
            <button type="button" class="btn btn-sm btn-link text-decoration-none text-danger p-0" id="btnClearFilter" style="display: none; font-size: 0.8rem;">
                <i class="bi bi-x-circle me-1"></i>Xóa lọc
            </button>
        </div>

        <!-- Danh sách thẻ loại món ăn (Xếp dọc, cuộn vô hạn mượt mà) -->
        <div class="food-filter-body">
            @await Component.InvokeAsync("TypeOfFood")
        </div>

        <!-- Frame Sắp xếp phía dưới -->
        <div class="food-filter-sort pt-3 border-top mt-auto">
            <label class="fw-bold text-uppercase fs-8 text-muted mb-2 d-block" style="font-size: 0.75rem;">Sắp xếp theo</label>
            <select class="form-select form-select-sm rounded-pill border" id="sortSelect">
                <option value="default">Mặc định</option>
                <option value="price_asc">Giá: Thấp đến Cao</option>
                <option value="price_desc">Giá: Cao đến Thấp</option>
                <option value="name_asc">Tên: A - Z</option>
            </select>
        </div>
    </aside>

    <!-- CỘT PHẢI: NỘI DUNG CHÍNH (TIÊU ĐỀ + TÌM KIẾM CỐ ĐỊNH, MÓN ĂN CUỘN) -->
    <main class="food-main-area">
        <!-- THANH CÔNG CỤ TRÊN CÙNG: TIÊU ĐỀ + Ô TÌM KIẾM + CHẾ ĐỘ XEM (CỐ ĐỊNH) -->
        <div class="food-top-toolbar">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold text-dark mb-0">Thực đơn món ăn</h5>
            </div>

            <!-- Ô tìm kiếm món ăn (Giao diện chuẩn bị sẵn cho bạn) -->
            <div class="food-search-box">
                <i class="bi bi-search text-muted"></i>
                <input type="text"
                       id="foodSearchInput"
                       class="form-control form-control-sm border-0 shadow-none bg-transparent"
                       placeholder="Tìm kiếm tên món ăn..." />
            </div>

            <div class="btn-group rounded-pill overflow-hidden border" role="group">
                <button type="button" class="btn btn-light btn-sm py-1 px-3 border-0"><i class="bi bi-list-ul"></i></button>
                <button type="button" class="btn btn-sm text-white py-1 px-3 border-0 active" style="background-color: #f97316;"><i class="bi bi-grid-3x3-gap-fill"></i></button>
            </div>
        </div>

        <!-- VÙNG RENDER BODY: DUY NHẤT VÙNG NÀY ĐƯỢC CUỘN LÊN XUỐNG -->
        <div class="food-scroll-container">
            @RenderBody()
        </div>
    </main>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
