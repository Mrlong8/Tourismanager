                </ul>

                <!-- Auth Status Menu Bên Phải -->
                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- KHI ĐÃ ĐĂNG NHẬP -->
                        <li class="nav-item">
            <button class="btn btn-outline-success text-success fw-bold px-3 py-1 rounded-pill d-flex align-items-center gap-2 custom-profile-btn"
                    type="button" 
                    data-bs-toggle="offcanvas" 
                    data-bs-target="#profileSidebar" 
                    aria-controls="profileSidebar">
                <i class="bi bi-person-circle fs-5"></i>
                <span>@User.Identity.Name</span>
            </button>
        </li>
                        <li class="nav-item">
