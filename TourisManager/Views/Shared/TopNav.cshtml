
<!-- Nhúng file CSS sửa lỗi Dropdown (z-index, overflow, căn lề phải) -->
<link rel="stylesheet" href="~/css/Shared/TopNav.css" asp-append-version="true" />
 
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow py-2">
        <div class="container-fluid">
            <!-- Brand Logo -->
            <a class="navbar-brand fw-bold text-success fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-compass-fill me-1"></i>TourisManager
            </a>
 
            <!-- Nút bật menu trên Mobile -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent"
                    aria-controls="navbarMainContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
 
            <!-- Khung menu chính -->
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarMainContent">
                <!-- Navigation Menu Bên Trái -->
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Map" asp-action="Index">Map</a>
                    </li>
 
                    @* <!-- Menu Dropdown Quản lý Chức năng (Đã sửa để không bị kẹt) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark fw-medium d-flex align-items-center" 
                           href="#" 
                           id="navbarAdmin" 
                           role="button" 
                           data-bs-toggle="dropdown" 
                           data-bs-auto-close="true"
                           aria-expanded="false">
                            Quản lý Chức năng
                        </a>
                        <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="navbarAdmin">
                            <li>
                                <a class="dropdown-item py-2" asp-area="Admin" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people me-2 text-primary"></i> Quản lý Người dùng
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Location" asp-action="Index">
                                    <i class="bi bi-geo-alt me-2 text-success"></i> Quản lý Địa điểm
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Restaurant" asp-action="Index">
                                    <i class="bi bi-cup-hot me-2 text-warning"></i> Quản lý Nhà hàng
                                </a>
                            </li>
                        </ul>
                    </li> *@
                </ul>
 
                <!-- Auth Status Menu Bên Phải -->
                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- KHI ĐÃ ĐĂNG NHẬP: 
                             LƯU Ý QUAN TRỌNG: Chỉ dùng <li class="nav-item"> không lồng thêm class "dropdown"
                             vì bên trong file MenuDropdown.cshtml đã có sẵn container <div class="dropdown">!
                             Lồng 2 lớp dropdown là nguyên nhân chính khiến menu bị xung đột click! -->
                        <li class="nav-item">
                            <partial name="MenuDropdown" />
                        </li>
                    }
                    else
                    {
                        <!-- KHI CHƯA ĐĂNG NHẬP -->
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-success text-success fw-semibold px-3 py-1 rounded-pill me-1"
                               asp-area="" asp-controller="Account" asp-action="Login">LogIn</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-success text-white fw-semibold px-3 py-1 rounded-pill shadow-sm"
                               asp-area="" asp-controller="Account" asp-action="Signup">SignUp</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
 