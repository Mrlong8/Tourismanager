<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3 py-2">
        <div class="container-fluid">
            <!-- Brand Logo -->
            <a class="navbar-brand fw-bold text-success fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-compass-fill me-1"></i>TourisManager
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <!-- Navigation Menu Bên Trái -->
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Map" asp-action="Index">Map</a>
                    </li>
                    <!-- Menu Dropdown Quản lý Chức năng (Chỉ hiển thị cho Admin/Seller) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="navbarAdmin" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Quản lý Chức năng
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarAdmin">
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">Quản lý Người dùng</a></li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Location" asp-action="Index">Quản lý Địa điểm</a></li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Restaurant" asp-action="Index">Quản lý Nhà hàng</a></li>
                        </ul>
                    </li>
                </ul>

                <!-- Auth Status Menu Bên Phải -->
                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- KHI ĐÃ ĐĂNG NHẬP: Gọi Partial View MenuDropdown -->
                        <li class="nav-item dropdown">
                            <partial name="MenuDropdown" />
                        </li>
                    }
                    else
                    {
                        <!-- KHI CHƯA ĐĂNG NHẬP -->
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-success text-success fw-semibold px-3 py-1 rounded-pill me-1"
                               asp-area="" asp-controller="Account" asp-action="Login">LogIn</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-success text-white fw-semibold px-3 py-1 rounded-pill shadow-sm"
                               asp-area="" asp-controller="Account" asp-action="Signup">SignUp</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>