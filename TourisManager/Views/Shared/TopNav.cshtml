<link rel="stylesheet" href="~/css/Shared/TopNav.css" asp-append-version="true" />
<header class="sticky-top border-bottom">
    <nav class="navbar navbar-expand-sm navbar-light bg-white py-2">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand fw-bold fs-4 shopee-brand"
               asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop me-1"></i>
                SuperFood
            </a>

            <!-- Toggler -->
            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMainContent"
                    aria-controls="navbarMainContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarMainContent">
                <ul class="navbar-nav flex-grow-1">
                    <!-- Ghim trạng thái Active bằng Razor -->
                    @{
                        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    }

                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Home" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Home" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Privacy">
                            Privacy
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Map" ? "active" : "")"
                           asp-area="" asp-controller="Map" asp-action="Index">
                            Map
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Food" ? "active" : "")"
                           asp-area="" asp-controller="Food" asp-action="Index">
                            Food
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Chat" ? "active" : "")"
                           asp-area="" asp-controller="Chat" asp-action="Index">
                            Chat
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Shop" ? "active" : "")"
                           asp-area="" asp-controller="Shop" asp-action="Invoice">
                            Hóa Đơn
                        </a>
                    </li>

                    @* Chỉ hiển thị Kênh Chủ Quán cho tài khoản có vai trò Seller hoặc Admin *@
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Seller") || User.IsInRole("Admin")))
                    {
                        <li class="nav-item mx-2">
                            <a class="nav-link fw-bold shopee-text @(ViewContext.RouteData.Values["area"]?.ToString() == "Seller" || currentController == "Dashboard" ? "active" : "")"
                               asp-area="Seller" asp-controller="Dashboard" asp-action="Index">
                                Kênh Chủ Quán
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <partial name="MenuDropdown" />
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-shopee fw-semibold px-4 py-1"
                               asp-area="" asp-controller="Account" asp-action="Login">
                                LogIn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-shopee fw-semibold px-4 py-1"
                               asp-area="" asp-controller="Account" asp-action="Signup">
                                SignUp
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>