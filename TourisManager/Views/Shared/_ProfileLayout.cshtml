@{
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<!-- Liên kết CSS độc lập cho Layout Profile -->
<link rel="stylesheet" href="~/css/Shared/_ProfileLayout.css" asp-append-version="true" />

<!-- KHUNG BỐ CỤC -->
<div class="profile-layout-wrapper" id="profileLayoutWrapper">

    <!-- CỘT TRÁI: SIDEBAR -->
    <aside class="profile-sidebar" aria-label="Sidebar Menu">
        <div>
            <!-- Header User -->
            <div class="sidebar-user-header">
                <div class="sidebar-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="sidebar-user-info">
                    <span class="sidebar-user-name">@(User.Identity?.Name ?? "Người dùng")</span>
                    <span class="sidebar-user-role">Thành viên TourisManager</span>
                </div>
            </div>

            <div class="sidebar-group-label">Quản lý tài khoản</div>

            <nav class="sidebar-menu-nav">
                <a asp-controller="Profile" asp-action="Index"
                   class="sidebar-link-item @(ViewData["Title"]?.ToString() == "Profile" ? "active" : "")"
                   data-title="Profile (Thông tin cá nhân)">
                    <i class="bi bi-person-circle"></i>
                    <span class="sidebar-item-text">Profile</span>
                </a>

                <a asp-controller="Profile" asp-action="ChangePassword"
                   class="sidebar-link-item @(ViewData["Title"]?.ToString() == "ChangePassword" ? "active" : "")"
                   data-title="Đổi mật khẩu">
                    <i class="bi bi-shield-lock"></i>
                    <span class="sidebar-item-text">Đổi mật khẩu</span>
                </a>
            </nav>

            <div class="sidebar-group-label mt-3">Quản lý đơn hàng</div>
            <nav class="sidebar-menu-nav">
                <a asp-controller="Profile" asp-action="MyOrder" class="sidebar-link-item" data-title="Đơn Hàng của tôi">
                    <i class="bi bi-journal-bookmark"></i>
                    <span class="sidebar-item-text">Đơn hàng của tôi</span>
                </a>
                <a asp-controller="Profile" asp-action="MyCart" class="sidebar-link-item" data-title="Giỏ Hàng của tôi">
                    <i class="bi bi-cart"></i>
                    <span class="sidebar-item-text">Giỏ Hàng của tôi</span>
                </a>
            </nav>
                <div class="sidebar-group-label mt-3">Tài Khoản, thanh toán</div>
            <nav class="sidebar-menu-nav">
                <a asp-controller="Wallet" asp-action="Index" class="sidebar-link-item" data-title="Ví của tôi">
                    <i class="bi bi-wallet2"></i>
                    <span class="sidebar-item-text">Ví của tôi</span>
                </a>

            </nav>
        </div>

        <div class="pt-3 border-top mt-auto">
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-logout-btn" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="sidebar-item-text">Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- CỘT PHẢI: NỘI DUNG CHÍNH -->
    <section class="profile-main-content">
        <!-- HEADER CỘT PHẢI -->
        <div class="profile-sub-header">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn-toggle-sidebar" id="btnToggleSidebar" title="Mở rộng menu">
                    <i class="bi bi-list text-orange"></i>
                </button>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="text-muted d-none d-sm-inline">Tài khoản</span>
                    <i class="bi bi-chevron-right text-muted d-none d-sm-inline" style="font-size: 11px;"></i>
                    <span class="fw-bold text-dark">@(ViewData["Title"]?.ToString() == "ChangePassword" ? "Đổi mật khẩu" : "Hồ sơ cá nhân")</span>
                </div>
            </div>

            <div class="d-none d-sm-flex align-items-center gap-2">
                <span class="text-muted small">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</span>
                <span class="header-meta-time" id="liveClock">@DateTime.Now.ToString("HH:mm:ss")</span>
            </div>
        </div>

        <!-- VÙNG RENDER NỘI DUNG VIEW CON -->
        <div class="profile-content-body">
            <div class="profile-card-container">
                @RenderBody()
            </div>
        </div>
    </section>
</div>

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    <script src="~/js/Shared/_ProfileLayout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}