
@using TourisManager.Core.Entities
@model IEnumerable<RoomChat>

@{
    ViewData["Title"] = "Tin nhắn"; 
    Layout = "~/Views/Shared/MyLayout.cshtml";

}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-success text-white p-3 rounded-top-4">
            <h4 class="mb-1">
                <i class="bi bi-chat-dots-fill me-2"></i>
                Tin nhắn
            </h4>
            <small>Trao đổi với nhà hàng của bạn</small>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                @foreach (var room in Model)
                {
                    <div class="d-flex align-items-center justify-content-between
                                border-bottom p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success-subtle
                                        text-success d-flex align-items-center
                                        justify-content-center"
                                 style="width:50px;height:50px;">
                                <i class="bi bi-shop fs-4"></i>
                            </div>

                            <div>
                                <h6 class="mb-1 fw-bold">
                                    @(room.Location?.Name ?? "Nhà hàng")
                                </h6>
                                <small class="text-muted">
                                    @(room.Location?.Address ?? "Chưa có địa chỉ")
                                </small>
                            </div>
                        </div>

                        <a asp-controller="Chat"
                           asp-action="Room"
                           asp-route-id="@room.RoomChatId"
                           class="btn btn-outline-success rounded-pill">
                            <i class="bi bi-chat me-1"></i>
                            Nhắn tin
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-square-text text-secondary"
                       style="font-size:3rem;"></i>

                    <h5 class="mt-3">Chưa có cuộc trò chuyện</h5>

                    <p class="text-muted mb-0">
                        Các cuộc trò chuyện sẽ hiển thị tại đây.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
