@model System.Collections.Generic.IEnumerable<TourisManager.Models.ViewModels.MapLocationViewModel>

@{
    ViewData["Title"] = "FoodieMap · Nhà hàng toàn quốc";
    ViewData["FullMap"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet.markercluster/MarkerCluster.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Map/Map.css" asp-append-version="true" />
}

<section id="touris-map" class="tm-map-page" aria-label="Bản đồ nhà hàng toàn quốc"
         data-details-url="@Url.Action("Details", "Location")" data-app-base="@Url.Content("~/")">
    <div id="map" aria-label="Bản đồ tương tác"></div>

    <aside id="map-sidebar" class="tm-sidebar" aria-labelledby="map-list-title">
        <div class="tm-sidebar-heading">
            <div>
                <p class="tm-eyebrow">FOODIEMAP · KHÁM PHÁ ẨM THỰC</p>
                <h1 id="map-list-title">Nhà hàng toàn quốc</h1>
            </div>
            <button id="map-close-list" class="tm-icon-button" type="button" aria-label="Ẩn danh sách" title="Ẩn danh sách">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 7-5 5 5 5" /></svg>
            </button>
        </div>
        <div class="tm-list-summary">
            <span id="map-result-count" role="status" aria-live="polite">Đang tải danh sách…</span>
            <button id="map-reset" class="tm-text-button" type="button" hidden>Xóa bộ lọc</button>
        </div>
        <div id="map-list" class="tm-place-list" aria-label="Danh sách kết quả"></div>
        <div class="tm-sidebar-footnote">Chọn một nhà hàng để xem vị trí trên bản đồ.</div>
    </aside>

    <button id="map-open-list" class="tm-open-list" type="button" aria-controls="map-sidebar" aria-expanded="true" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h12M9 12h12M9 18h12M3 6h.01M3 12h.01M3 18h.01" /></svg>
        <span>Danh sách</span><span id="map-list-badge">0</span>
    </button>

    <div class="tm-toolbar">
        <form id="map-search-form" class="tm-search" role="search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
            <label class="tm-sr-only" for="map-search">Tìm nhà hàng hoặc món ăn</label>
            <input id="map-search" type="search" autocomplete="off" maxlength="200"
                   placeholder="Tìm món ăn, nhà hàng, tỉnh thành…" />
            <button id="map-clear-search" class="tm-icon-button" type="button" aria-label="Xóa từ khóa" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
            </button>
        </form>
        <div class="tm-filter-row" aria-label="Lọc kết quả">
            <div class="tm-type-filters" role="group" aria-label="Danh mục nhà hàng">
                @foreach (var category in TourisManager.Data.Seed.RestaurantSeed.CategoryNames)
                {
                    <button class="tm-filter-chip tm-filter-restaurant" type="button" data-map-type="@category" aria-pressed="false">
                        @category <span class="tm-chip-count" data-category-count="@category">0</span>
                    </button>
                }
            </div>
            <div class="tm-area-filter">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Zm6-3v15m6-12v15" /></svg>
                <label class="tm-sr-only" for="map-area">Lọc theo khu vực</label>
                <select id="map-area"><option value="">Toàn quốc</option></select>
            </div>
        </div>
    </div>

    <div class="tm-base-layers" role="group" aria-label="Chọn nền bản đồ">
        <button type="button" data-map-layer="road" aria-pressed="true">Google</button>
        <button type="button" data-map-layer="satellite" aria-pressed="false">Vệ tinh</button>
        <button type="button" data-map-layer="osm" aria-pressed="false">OSM</button>
    </div>

    <div class="tm-map-controls" role="group" aria-label="Điều khiển bản đồ">
        <button id="map-fit" class="tm-control-button" type="button" aria-label="Xem tất cả kết quả trên bản đồ" title="Xem tất cả kết quả">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M8 8l-5-5m13 5 5-5M8 16l-5 5m13-5 5 5" /></svg>
        </button>
        <button id="map-locate" class="tm-control-button" type="button" aria-label="Tìm vị trí của tôi" title="Vị trí của tôi">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6.5" /><circle cx="12" cy="12" r="2" /><path d="M12 2v3m0 14v3M2 12h3m14 0h3" /></svg>
        </button>
        <div class="tm-zoom-buttons">
            <button id="map-zoom-in" class="tm-control-button" type="button" aria-label="Phóng to" title="Phóng to">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg>
            </button>
            <button id="map-zoom-out" class="tm-control-button" type="button" aria-label="Thu nhỏ" title="Thu nhỏ">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
            </button>
        </div>
        <button id="map-fullscreen" class="tm-control-button" type="button" aria-label="Mở toàn màn hình" aria-pressed="false" title="Toàn màn hình">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
        </button>
    </div>

    <div id="map-message" class="tm-map-message" role="status" aria-live="polite" hidden></div>
    <noscript><div class="tm-map-message">Bạn cần bật JavaScript để sử dụng bản đồ và tìm kiếm.</div></noscript>
</section>

<script id="map-locations-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/lib/leaflet.markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/map/map.js" asp-append-version="true"></script>
}
