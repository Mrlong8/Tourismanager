@model IEnumerable<TourisManager.Core.Entities.Location>

@{
    ViewData["Title"] = "Leaflet";
}

<!-- CSS của Leaflet CDN & CSS tùy chỉnh -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="~/css/Map/Map.css" asp-append-version="true" />

<div id="map"></div>

<!-- Đưa dữ liệu C# Model sang biến JavaScript -->
<script>
    window.locationsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
</script>

<!-- JS của Leaflet CDN & JS tùy chỉnh -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="~/js/Map/map.js" asp-append-version="true"></script>