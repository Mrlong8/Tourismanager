@model IEnumerable<TourisManager.Core.Entities.SavedFood>

@{
    ViewData["Title"] = "Giỏ Hàng";
    Layout = "~/Views/Shared/_ProfileLayout.cshtml";
}

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase fw-bold">
                    <tr>
                        <th scope="col" class="ps-3 border-0 py-3" style="min-width: 200px;">Món ăn</th>
                        <th scope="col" class="text-center border-0 py-3">Phân loại</th>
                        <th scope="col" class="text-end border-0 py-3">Đơn giá</th>
                        <th scope="col" class="text-center border-0 py-3" style="min-width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var food = item.Food;
                        var minPrice = food?.FoodSizes != null && food.FoodSizes.Any()
                            ? food.FoodSizes.Min(fs => fs.Price) : (decimal?)null;

                        <tr>
                            <td class="ps-3 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <a href="@Url.Action("Details", "Location", new { id = food.LocationId })" class="flex-shrink-0 text-decoration-none">
                                        <img src="@(string.IsNullOrWhiteSpace(food?.ImageUrl) ? "/Image/Food/kimchi.jpg" : food.ImageUrl)"
                                             alt="@(food?.Name ?? "Món ăn")"
                                             class="rounded-3 object-fit-cover shadow-sm border"
                                             style="width: 64px; height: 64px;"
                                             onerror="this.onerror=null; this.src='/Image/Food/default_food.jpg';" />
                                    </a>
                                    <div class="overflow-hidden">
                                        <!-- Link bọc tên -->
                                        <a href="@Url.Action("Details", "Location", new { id = food.LocationId })" class="text-decoration-none text-dark fw-bold text-truncate d-block" title="@food?.Name">
                                            @(food?.Name ?? "Chưa cập nhật")
                                        </a>
                                        <small class="text-muted text-truncate d-block" style="font-size: 0.8rem;">
                                            @(string.IsNullOrEmpty(food?.Description) ? "Thơm ngon chuẩn vị" : food.Description)
                                        </small>
                                    </div>
                            </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-secondary border px-2.5 py-1.5 fw-normal rounded-2">
                                    <i class="bi bi-tag-fill me-1" style="color: #ff5722;"></i>@(food?.TypeFood?.Name ?? "Đồ ăn")
                                </span>
                            </td>
                            <td class="text-end fw-bold fs-6" style="color: #ff5722;">
                                @(minPrice.HasValue ? minPrice.Value.ToString("N0") + " đ" : "Liên hệ")
                            </td>
                            <td class="text-center pe-3">
                                <button type="button"
                                        class="btn btn-sm text-white fw-bold px-3 py-2 rounded-2 shadow-sm border-0"
                                        style="background-color: #ff5722;"
                                        onclick="openModal('@item.FoodId');">
                                    <i class="bi bi-cart-check-fill me-1"></i>Đặt hàng
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger fw-bold px-3 py-2 rounded-2 shadow-sm"
                                        onclick="removeFromCart('@item.FoodId');"
                                        title="Xóa khỏi giỏ hàng">
                                    <i class="bi bi-trash3-fill me-1"></i>Xóa
                                </button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="col-12 w-100 text-center py-5 bg-white rounded-3 border shadow-sm">
        <i class="bi bi-basket text-muted display-4"></i>
        <p class="text-muted mt-2 mb-0 fw-medium">Không có món ăn nào trong giỏ hàng!</p>
    </div>
}

<!-- Khung Modal rỗng, chờ AJAX đổ dữ liệu vào thẻ div .modal-content -->
<div class="modal fade" id="quickOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="quickOrderModalContent">
            <!-- PartialView sẽ được nhét vào đây qua AJAX -->
        </div>
    </div>
</div>


@section Scripts{
    <script src="~/js/FoodOrder/QuickOrder.js"></script>

    <script>

        function removeFromCart(foodId) {
            if (!foodId) {
                alert('Mã món ăn không hợp lệ!');
                return;
            }

            if (!confirm('Bạn có chắc chắn muốn xóa món ăn này khỏi giỏ hàng?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("RemoveFromCart", "Profile")',
                type: 'POST',
                data: { foodId: foodId },
                success: function (response) {
                    if (response.success) {
                        location.reload(); // Làm mới lại trang
                    } else {
                        alert(response.message || 'Xóa thất bại, vui lòng thử lại!');
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra khi xóa món ăn khỏi giỏ hàng.');
                }
            });
        }
    </script>
}