@model TourisManager.Core.Entities.Account

@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "Profile";
}

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
        <span>@TempData["Msg"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="profile-page-header">
    <h3 class="profile-page-title">Profile</h3>
    <p class="profile-page-subtitle">Quản lý và cập nhật thông tin cá nhân của bạn.</p>
</div>

<!-- KHU VỰC AVATAR -->
<div class="profile-avatar-section">
    <div class="profile-avatar-frame">
        <img id="avatarPreview"
             src="@(string.IsNullOrEmpty(Model?.AvataUrl) ? "/Image/Upload/avatadefault.jpg" : Model.AvataUrl)"
             alt="Avatar">
    </div>

    <input type="file" id="avatarFile" name="avatarFile" class="d-none" accept="image/*" onchange="previewAvatar(this)">

    <div>
        <div id="defaultAvatarActions">
            <button type="button" class="btn btn-avatar-edit d-inline-flex align-items-center gap-1.5" onclick="document.getElementById('avatarFile').click()">
                <i class="bi bi-camera"></i>
                <span>Thay đổi ảnh</span>
            </button>
        </div>

        <div id="uploadAvatarActions" class="d-none gap-2">
            <button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-medium" onclick="cancelAvatarUpload()">Hủy</button>
            <button type="button" class="btn btn-sm btn-success px-3 rounded-pill fw-medium text-white" onclick="submitAvatarAjax()">Lưu ảnh</button>
        </div>

        <div class="small text-muted mt-1" style="font-size: 0.775rem;">Hỗ trợ ảnh JPG, PNG, WEBP (Tối đa 2MB)</div>
        <div id="uploadStatus" class="small mt-1"></div>
    </div>
</div>

<!-- FORM THÔNG TIN -->
<form asp-controller="Profile" asp-action="Index" method="post" style="max-width: 600px;">
    @Html.AntiForgeryToken()

    <div class="mb-4">
        <label asp-for="Name" class="form-label fw-semibold text-dark small mb-1">
            Họ và tên <span class="text-danger">*</span>
        </label>
        <input asp-for="Name" class="form-control" placeholder="Nhập họ và tên..." />
        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
    </div>

    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label fw-semibold text-dark small mb-0">
                Email <span class="text-danger">*</span>
            </label>
            <span class="badge bg-light text-secondary border px-2 py-0.5 small">Không đổi</span>
        </div>
        <input type="email" class="form-control" value="@Model?.Email" readonly />
    </div>

    <button type="submit" class="btn btn-success">
        Save Profile
    </button>
</form>

@section Scripts {
    <script src="~/js/Profile/Index.js" asp-append-version="true"></script>
}