@model TourisManager.Models.ViewModels.ChangePassword
@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "ChangePassword";
}

<div class="profile-page-header">
    <h3 class="profile-page-title">Đổi mật khẩu</h3>
    <p class="profile-page-subtitle">Cập nhật mật khẩu để tăng cường bảo mật cho tài khoản của bạn.</p>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
        <span>@TempData["Msg"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-controller="Profile" asp-action="ChangePassword" method="post" style="max-width: 520px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3.5">
        <label asp-for="CurrentPassword" class="form-label fw-semibold text-dark small mb-1">
            Mật khẩu hiện tại <span class="text-danger">*</span>
        </label>
        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại..." />
        <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
    </div>

    <div class="mb-3.5">
        <label asp-for="NewPassword" class="form-label fw-semibold text-dark small mb-1">
            Mật khẩu mới <span class="text-danger">*</span>
        </label>
        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." />
        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold text-dark small mb-1">
            Xác nhận mật khẩu mới <span class="text-danger">*</span>
        </label>
        <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới..." />
        <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Cập nhật mật khẩu
    </button>
</form>