@model TourisManager.Models.ViewModels.ChangePassword
@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "ChangePassword";
}


<div class="col-lg-9 col-md-8 ps-md-4">
    <h3 class="fw-bold mb-1">Đổi mật khẩu</h3>
    <p class="text-muted mb-4">Cập nhật mật khẩu để tăng cường bảo mật cho tài khoản của bạn.</p>

@if (TempData["Msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Profile" asp-action="ChangePassword" method="post" style="max-width: 500px;">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label fw-medium">Mật khẩu hiện tại <span class="text-danger">*</span></label>
            <input asp-for="CurrentPassword" class="form-control py-2 shadow-none border-secondary-subtle" placeholder="Nhập mật khẩu hiện tại" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-medium">Mật khẩu mới <span class="text-danger">*</span></label>
            <input asp-for="NewPassword" class="form-control py-2 shadow-none border-secondary-subtle" placeholder="Tối thiểu 6 ký tự" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label fw-medium">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
            <input asp-for="ConfirmNewPassword" class="form-control py-2 shadow-none border-secondary-subtle" placeholder="Nhập lại mật khẩu mới" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-success px-4 py-2 fw-medium rounded-3">
            Cập nhật mật khẩu
        </button>
    </form>
</div>