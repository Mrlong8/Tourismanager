@model TourisManager.Core.Entities.Food

@{
    var foodSizes = Model.FoodSizes?.OrderBy(fs => fs.Price).ToList() ?? new List<TourisManager.Core.Entities.FoodSize>();
    var defaultPrice = foodSizes.Any() ? foodSizes.First().Price : 0;
    var deliveryFee = ViewBag.DeliveryFee != null ? Convert.ToDecimal(ViewBag.DeliveryFee) : 10000m;
    var distance = ViewBag.Distance != null ? Convert.ToDouble(ViewBag.Distance) : 2.0;
    var initialTotal = defaultPrice + deliveryFee;
}

<div class="modal-header border-bottom-0 pb-0">
    <h5 class="modal-title fw-bold text-dark" id="modalFoodName">@Model.Name</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <input type="hidden" id="modalFoodId" value="@Model.FoodId" />
    <!-- THÊM DÒNG NÀY: Lưu giá mặc định để JS gọi khi món không có size -->
    <input type="hidden" id="modalBasePrice" value="@Convert.ToInt32(defaultPrice)" />

    <div class="d-flex gap-3 mb-3">
        <img id="modalFoodImg" 
             src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/Image/Food/default_food.jpg" : Model.ImageUrl)" 
             alt="@Model.Name" 
             class="rounded-3 object-fit-cover" 
             style="width: 80px; height: 80px;"
             onerror="this.onerror=null; this.src='/Image/Food/default_food.jpg';" />
        <div>
            <p class="text-danger fw-bold mb-1 fs-5" id="modalDisplayPrice">@defaultPrice.ToString("N0") đ</p>
            <p class="text-muted small mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Vui lòng chọn size và số lượng bên dưới" : Model.Description)</p>
        </div>
    </div>

    <hr class="text-muted">

    <div class="mb-3">
        <label class="fw-bold mb-2">Chọn Size</label>
        <div class="d-flex flex-wrap gap-2">
            @if (foodSizes.Any())
            {
                int index = 0;
                foreach (var fs in foodSizes)
                {
                    var isChecked = index == 0 ? "checked" : "";
                    var inputId = $"size_{fs.SizeId}_{fs.FoodId}";
                    var sizeName = fs.Size != null && !string.IsNullOrEmpty(fs.Size.Name) ? fs.Size.Name : "Tiêu chuẩn";

                    <!-- SỬA LẠI: Ép kiểu nguyên value để tránh lỗi parseFloat trong JS -->
                    <input type="radio" 
                           class="btn-check size-option" 
                           name="foodSize" 
                           id="@inputId" 
                           autocomplete="off" 
                           value="@Convert.ToInt32(fs.Price)" 
                           data-size-id="@fs.SizeId"
                           @isChecked 
                           onchange="updateModalPrice()">
                    <label class="btn btn-outline-danger btn-sm px-3" for="@inputId">
                        @sizeName (@fs.Price.ToString("N0") đ)
                    </label>
                    index++;
                }
            }
            else
            {
                <div class="text-muted small">Món ăn này chưa có phân loại size.</div>
            }
        </div>
    </div>

    <div class="mb-3 d-flex align-items-center justify-content-between">
        <label class="fw-bold">Số lượng</label>
        <div class="input-group input-group-sm" style="width: 110px;">
            <button class="btn btn-outline-secondary" type="button" id="btnMinus" onclick="updateQty(-1)">-</button>
            <input type="text" class="form-control text-center fw-bold" id="inputQty" value="1" readonly>
            <button class="btn btn-outline-secondary" type="button" id="btnPlus" onclick="updateQty(1)">+</button>
        </div>
    </div>

    <hr class="text-muted">

    <div class="mb-3">
        <label class="fw-bold mb-2">Phương thức thanh toán</label>
        <div class="d-flex flex-column gap-2">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" id="payCOD" value="1" checked onchange="togglePaymentMethod()">
                <label class="form-check-label" for="payCOD">
                    <i class="bi bi-cash-stack text-success me-1"></i> Thanh toán khi nhận hàng (COD)
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" id="payQR" value="2" onchange="togglePaymentMethod()">
                <label class="form-check-label" for="payQR">
                    <i class="bi bi-qr-code-scan text-primary me-1"></i> Chuyển khoản QR Code (SePay / VietQR)
                </label>
            </div>
        </div>
    </div>

    <div id="qrCodeContainer" class="text-center d-none bg-light p-3 rounded-3 mt-2 border">
        <p class="fw-bold text-primary mb-2">Quét mã VietQR để thanh toán</p>
       
        <div class="d-flex justify-content-center my-2">
            <img id="qrCodeImg" src="" alt="Mã QR Thanh Toán" class="img-fluid rounded border shadow-sm p-1 bg-white" style="max-width: 220px;" />
        </div>
        <div class="mt-2 text-start small bg-white p-2.5 rounded border">
            <p class="mb-1"><strong>Ngân hàng:</strong> MBBank (Ngân hàng Quân Đội)</p>
            <p class="mb-1"><strong>Số tài khoản:</strong> <span class="text-dark fw-bold">0347109478</span></p>
            <p class="mb-1"><strong>Chủ tài khoản:</strong> <span class="text-dark fw-bold">BUI XUAN LONG</span></p>
            <p class="mb-0"><strong>Nội dung CK:</strong> <span class="text-danger fw-bold">DH @Model.FoodId</span></p>
        </div>
    </div>

    <!-- SỬA LẠI: Ép kiểu nguyên cho data-fee -->
    <div class="d-flex justify-content-between align-items-center bg-white px-2 mt-2">
        <span class="text-muted small">Phí giao hàng (<span id="modalDistance">@distance.ToString("0.0")</span> km):</span>
        <span class="fw-bold text-dark" id="modalDeliveryFee" data-fee="@Convert.ToInt32(deliveryFee)">@deliveryFee.ToString("N0") đ</span>
    </div>
    
    <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 mt-3">
        <span class="fw-bold text-dark">Tổng tiền thanh toán:</span>
        <span class="fw-bold text-danger fs-5" id="modalTotalPrice">@initialTotal.ToString("N0") đ</span>
    </div>
</div>

<div class="modal-footer border-top-0 pt-0">
    <button type="button" id="btnCheckout" class="btn btn-danger w-100 fw-bold py-2 shadow-sm" onclick="processCheckout()">
        Thanh Toán khi nhận hàng
    </button>
</div>