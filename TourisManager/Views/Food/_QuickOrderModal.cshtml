<!-- Modal Đặt món nhanh -->
<div class="modal fade" id="quickOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="modalFoodName">Tên món ăn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
                <div class="d-flex gap-3 mb-3">
                    <!-- Ảnh món -->
                    <img id="modalFoodImg" src="" alt="" class="rounded-3 object-fit-cover" style="width: 80px; height: 80px;">
                    <div>
                        <p class="text-danger fw-bold mb-1 fs-5" id="modalDisplayPrice">0 đ</p>
                        <p class="text-muted small mb-0">Vui lòng chọn size và số lượng bên dưới</p>
                    </div>
                </div>

                <hr class="text-muted">

                <!-- Chọn Size (Ví dụ tĩnh, thực tế bạn có thể load AJAX hoặc render sẵn từ View) -->
                <div class="mb-3">
                    <label class="fw-bold mb-2">Chọn Size</label>
                    <div class="d-flex gap-2">
                        <input type="radio" class="btn-check size-option" name="foodSize" id="sizeS" autocomplete="off" value="0" checked>
                        <label class="btn btn-outline-danger btn-sm px-3" for="sizeS">Size S</label>

                        <input type="radio" class="btn-check size-option" name="foodSize" id="sizeM" autocomplete="off" value="10000">
                        <label class="btn btn-outline-danger btn-sm px-3" for="sizeM">Size M (+10k)</label>

                        <input type="radio" class="btn-check size-option" name="foodSize" id="sizeL" autocomplete="off" value="20000">
                        <label class="btn btn-outline-danger btn-sm px-3" for="sizeL">Size L (+20k)</label>
                    </div>
                </div>

                <!-- Chọn số lượng -->
                <div class="mb-3 d-flex align-items-center justify-content-between">
                    <label class="fw-bold">Số lượng</label>
                    <div class="input-group input-group-sm" style="width: 110px;">
                        <button class="btn btn-outline-secondary" type="button" id="btnMinus" onclick="updateQty(-1)">-</button>
                        <input type="text" class="form-control text-center fw-bold" id="inputQty" value="1" readonly>
                        <button class="btn btn-outline-secondary" type="button" id="btnPlus" onclick="updateQty(1)">+</button>
                    </div>
                </div>

                <!-- Tổng cộng -->
                <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 mt-3">
                    <span class="fw-bold text-dark">Tổng tiền:</span>
                    <span class="fw-bold text-danger fs-5" id="modalTotalPrice">0 đ</span>
                </div>
            </div>

            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-danger w-100 fw-bold py-2 shadow-sm" onclick="processCheckout()">
                    Xác nhận & Thanh toán
                </button>
            </div>
        </div>
    </div>
</div>