@model IEnumerable<TourisManager.Core.Entities.Food>

@{
    ViewData["Title"] = "Thực Đơn Món Ăn";
    Layout = "_LayoutFood"; 
}

<!-- ID 'food-container' là nơi AJAX sẽ đổ dữ liệu (PartialView) vào đây -->
<div id="food-container">
    <partial name="_FoodGridPartial" model="Model" />
</div>

<!-- Khung Modal rỗng, chờ AJAX đổ dữ liệu vào thẻ div .modal-content -->
<div class="modal fade" id="quickOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="quickOrderModalContent">
            <!-- PartialView sẽ được nhét vào đây qua AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mảng lưu danh sách các loại món được chọn (hỗ trợ lọc nhiều)
        var selectedTypeIds = [];
        var currentPage = 1;

        // 1. Click vào từng thẻ lọc loại món
        $(document).on('click', '.btn-food-filter-chip', function (e) {
            e.preventDefault();
            var $chip = $(this);
            var typeId = $chip.attr('data-id') ? String($chip.attr('data-id')).trim() : "";

            if (!typeId) {
                selectedTypeIds = [];
                $('.btn-food-filter-chip').removeClass('active');
                $chip.addClass('active');
                $('#btnClearFilter').hide();
            } else {
                $('.btn-food-filter-chip[data-id=""]').removeClass('active');

                var index = selectedTypeIds.indexOf(typeId);
                if (index > -1) {
                    selectedTypeIds.splice(index, 1);
                    $chip.removeClass('active');
                } else {
                    selectedTypeIds.push(typeId);
                    $chip.addClass('active');
                }

                if (selectedTypeIds.length === 0) {
                    $('.btn-food-filter-chip[data-id=""]').addClass('active');
                    $('#btnClearFilter').hide();
                } else {
                    $('#btnClearFilter').show();
                }
            }

            currentPage = 1;
            loadFoods(1);
        });

        // 2. Nút Xóa bộ lọc
        $(document).on('click', '#btnClearFilter', function (e) {
            e.preventDefault();
            selectedTypeIds = [];
            $('.btn-food-filter-chip').removeClass('active');
            $('.btn-food-filter-chip[data-id=""]').addClass('active');
            $(this).hide();
            currentPage = 1;
            loadFoods(1);
        });

        // 3. Click phân trang (bỏ qua nút disabled)
        $('body').on('click', '.page-item:not(.disabled)', function (e) {
            e.preventDefault();
            var page = $(this).attr("page");
            if (page) {
                currentPage = parseInt(page);
                loadFoods(currentPage);
            }
        });

        // Hàm gọi AJAX tải dữ liệu
        function loadFoods(pageIndex) {
            // Chuẩn bị dữ liệu gửi đi
            var requestData = {
                pageIndex: pageIndex
            };

            if (selectedTypeIds.length > 0) {
                requestData.typeIds = selectedTypeIds;
            }

            $.ajax({
                url: '@Url.Action("FilterFoodsByType", "Food")',
                type: 'GET',
                traditional: true, // Cho phép truyền mảng typeIds lên action của ASP.NET Core MVC
                data: requestData,
                success: function (html) {
                    $('#food-container').html(html);
                    // Cuộn danh sách lên đầu
                    $('.food-scroll-container').scrollTop(0);
                },
                error: function () {
                    alert('Có lỗi xảy ra khi tải dữ liệu thực đơn.');
                }
            });
        }

        // ==================== XỬ LÝ QUICK ORDER MODAL ====================
        function openModal(foodId) {
            $.ajax({
                url: '@Url.Action("LoadQuickOrderModal", "Food")',
                type: 'GET',
                data: { id: foodId },
                success: function (html) {
                    $('#quickOrderModalContent').html(html);
                    updateModalPrice();
                    var modalEl = document.getElementById('quickOrderModal');
                    var myModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    myModal.show();
                },
                error: function (xhr) {
                    alert('Lỗi tải dữ liệu món ăn: ' + (xhr.responseText || 'Không tìm thấy thông tin món ăn!'));
                }
            });
        }

        function updateQty(change) {
            let currentQty = parseInt($('#inputQty').val()) || 1;
            let newQty = currentQty + change;
            if (newQty >= 1) {
                $('#inputQty').val(newQty);
                updateModalPrice();
            }
        }

        function updateModalPrice() {
            let price = parseFloat($('input[name="foodSize"]:checked').val()) || 0;
            let qty = parseInt($('#inputQty').val()) || 1;
            let total = price * qty;

            $('#modalDisplayPrice').text(price.toLocaleString('vi-VN') + ' đ');
            $('#modalTotalPrice').text(total.toLocaleString('vi-VN') + ' đ');
        }
    </script>
}
