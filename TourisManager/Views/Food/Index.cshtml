@model IEnumerable<TourisManager.Core.Entities.Food>

@{
    ViewData["Title"] = "Thực Đơn Món Ăn";
    Layout = "_LayoutFood"; 
}

<!-- ID 'food-container' là nơi AJAX sẽ đổ dữ liệu (PartialView) vào đây -->
<div id="food-container">
    <partial name="_FoodGridPartial" model="Model" />
</div>

<!-- Khung Modal rỗng, chờ AJAX đổ dữ liệu vào thẻ div .modal-content -->
<div class="modal fade" id="quickOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="quickOrderModalContent">
            <!-- PartialView sẽ được nhét vào đây qua AJAX -->
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var selectedTypeIds = [];
        var currentPage = 1;

        var currentSearchKeyword = "";
        var searchTimeout = null;

        // tìm kiếm
        $(document).on('input', '#foodSearchInput', function () {
            clearTimeout(searchTimeout); 
            currentSearchKeyword = $(this).val().trim();

            searchTimeout = setTimeout(function () {
                currentPage = 1; // Reset về trang 1 khi tìm kiếm mới
                loadFoods(1);
            }, 500);
        });

        // 1. Click vào từng thẻ lọc loại món
        $(document).on('click', '.btn-food-filter-chip', function (e) {
            e.preventDefault();
            var $chip = $(this);
            var typeId = $chip.attr('data-id') ? String($chip.attr('data-id')).trim() : "";

            if (!typeId) {
                selectedTypeIds = [];
                $('.btn-food-filter-chip').removeClass('active');
                $chip.addClass('active');
                $('#btnClearFilter').hide();
            } else {
                $('.btn-food-filter-chip[data-id=""]').removeClass('active');

                var index = selectedTypeIds.indexOf(typeId);
                if (index > -1) {
                    selectedTypeIds.splice(index, 1);
                    $chip.removeClass('active');
                } else {
                    selectedTypeIds.push(typeId);
                    $chip.addClass('active');
                }

                if (selectedTypeIds.length === 0) {
                    $('.btn-food-filter-chip[data-id=""]').addClass('active');
                    $('#btnClearFilter').hide();
                } else {
                    $('#btnClearFilter').show();
                }
            }

            currentPage = 1;
            loadFoods(1);
        });

        // 2. Nút Xóa bộ lọc
        $(document).on('click', '#btnClearFilter', function (e) {
            e.preventDefault();
            selectedTypeIds = [];
            $('.btn-food-filter-chip').removeClass('active');
            $('.btn-food-filter-chip[data-id=""]').addClass('active');
            $(this).hide();

            $('#foodSearchInput').val('');
            currentSearchKeyword = "";

            currentPage = 1;
            loadFoods(1);
        });

        // 3. Click phân trang (bỏ qua nút disabled)
        $('body').on('click', '.page-item:not(.disabled)', function (e) {
            e.preventDefault();
            var page = $(this).attr("page");
            if (page) {
                currentPage = parseInt(page);
                loadFoods(currentPage);
            }
        });

        // Hàm gọi AJAX tải dữ liệu
              // Hàm gọi AJAX tải dữ liệu thực đơn mượt mà, không hiển thị alert nếu gặp lỗi
        function loadFoods(pageIndex) {
            var requestData = {
                pageIndex: pageIndex,
                keyword: currentSearchKeyword
            };

            if (selectedTypeIds.length > 0) {
                requestData.typeIds = selectedTypeIds;
            }

            $.ajax({
                url: '/Food/FilterFoodsByType',
                type: 'GET',
                traditional: true,
                data: requestData,
                success: function (html) {
                    $('#food-container').html(html);
                    $('.food-scroll-container').scrollTop(0);
                },
                error: function (xhr) {
                    console.log("Lỗi tải dữ liệu: ", xhr.responseText);
                }
            });
        }
                   function addToCart(foodId) {
            if (!foodId) {
                alert('Mã món ăn không hợp lệ!');
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("AddFoodToMyCart", "Profile")',
                type: 'POST',
                data: { 
                    foodId: foodId,
                    __RequestVerificationToken: token 
                },
                success: function (response) {
                    if (response.success) {
                        alert(response.message || 'Thêm vào giỏ hàng thành công!');
                    } else {
                        alert(response.message || 'Thêm vào giỏ hàng thất bại!');
                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert('Lỗi ' + xhr.status + ': Không thể thêm vào giỏ hàng.');
                }
            });
        }
    </script>
    <script src="~/js/FoodOrder/QuickOrder.js" asp-append-version="true"></script>

}
