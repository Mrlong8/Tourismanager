@model IEnumerable<TourisManager.Core.Entities.Food>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            var minPrice = item.FoodSizes != null && item.FoodSizes.Any()
                ? item.FoodSizes.Min(fs => fs.Price) : (decimal?)null;

            <div class="col">
                <a href="@Url.Action("Detail", "Food", new { id = item.FoodId })" class="card-food-link">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative card-food-item bg-white">
                        <div class="position-absolute top-0 start-0 m-2 z-1">
                            <span class="badge bg-danger text-white fw-normal px-2 py-1 shadow-sm">
                                <i class="bi bi-tag-fill me-1"></i>@(item.TypeFood?.Name ?? "Đồ ăn")
                            </span>
                        </div>

                        <div class="ratio ratio-4x3 bg-light overflow-hidden">
                            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/Image/Food/default_food.jpg" : item.ImageUrl)"
                                 alt="@item.Name" class="card-img-top object-fit-cover transition-img"
                                 onerror="this.onerror=null; this.src='/Image/Food/default_food.jpg';" />
                        </div>

                        <div class="card-body p-2.5 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="card-title fw-bold text-dark text-truncate mb-1" title="@item.Name">@item.Name</h6>
                                <p class="card-text text-muted small text-truncate mb-2" style="font-size: 0.8rem;">
                                    @(string.IsNullOrEmpty(item.Description) ? "Thơm ngon chuẩn vị" : item.Description)
                                </p>
                            </div>
                            <div>
                                <div class="d-flex align-items-center justify-content-between my-2">
                                    <span class="fw-bold text-danger fs-6">
                                        @(minPrice.HasValue ? "Giá chỉ từ: " + minPrice.Value.ToString("N0") + " đ" : "Liên hệ")
                                    </span>
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm rounded-2 d-flex align-items-center justify-content-center px-3"
                                            title="Thêm vào giỏ hàng"
                                            onclick="event.stopPropagation(); event.preventDefault(); addToCart('@item.FoodId');">
                                        <i class="bi bi-cart-plus fs-6"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger btn-sm rounded-2 fw-bold d-flex align-items-center justify-content-center flex-grow-1 gap-1"
                                            onclick="event.stopPropagation(); event.preventDefault(); openModal('@item.FoodId');">
                                        <span>Đặt hàng ngay</span>
                                    </button>
                                    <button type="button"
                                            class="btn p-0 border-0 bg-transparent text-orange"
                                            title="Lưu món ăn"
                                            onclick="event.stopPropagation(); event.preventDefault(); toggleSaveFood('@item.FoodId', this);">
                                        <i class="bi bi-star fs-4" style="color: #f97316;"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12 w-100 text-center py-5 bg-white rounded border">
            <p class="text-muted mt-2 mb-0">Không có món ăn nào trong danh mục này!</p>
        </div>
    }
</div>

<!-- ================= PHÂN TRANG THU GỌN VỚI DẤU "..." VÀ MŨI TÊN ================= -->
@{
    int totalPages = ViewBag.pageNum ?? 0;
    int curPage = ViewBag.pageIndex ?? 1;
}

@if (totalPages > 1)
{
    <div class="d-flex justify-content-center mt-4 pb-3">
        <ul class="pagination pagination-sm m-0 shadow-sm rounded-2 overflow-hidden border">
            <!-- Nút Về Trước « -->
            <li class="page-item @(curPage <= 1 ? "disabled" : "")" page="@(curPage - 1)">
                <a class="page-link" href="javascript:void(0);" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            @{
                // Xác định phạm vi các trang hiển thị quanh trang hiện tại (±2 trang)
                int startPage = Math.Max(1, curPage - 2);
                int endPage = Math.Min(totalPages, curPage + 2);

                // Trang 1 đầu tiên
                if (startPage > 1)
                {
                    <li class="page-item" page="1">
                        <a class="page-link" href="javascript:void(0);">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link text-muted">...</span>
                        </li>
                    }
                }

                // Các trang ở giữa
                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(curPage == i ? "active" : "")" page="@i">
                        <a class="page-link" href="javascript:void(0);">@i</a>
                    </li>
                }

                // Trang cuối cùng
                if (endPage < totalPages)
                {
                    if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link text-muted">...</span>
                        </li>
                    }
                    <li class="page-item" page="@totalPages">
                        <a class="page-link" href="javascript:void(0);">@totalPages</a>
                    </li>
                }
            }

            <!-- Nút Kế Tiếp » -->
            <li class="page-item @(curPage >= totalPages ? "disabled" : "")" page="@(curPage + 1)">
                <a class="page-link" href="javascript:void(0);" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </div>
}
