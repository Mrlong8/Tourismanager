@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<style>
    /* CSS cho Sidebar Kênh Người Bán đồng bộ màu cam thương hiệu */
    .seller-sidebar { 
        background-color: #ffffff; 
        border-right: 1px solid #e0e0e0;
        min-height: 80vh; 
    }
    .seller-sidebar .nav-link { 
        color: #495057; 
        padding: 12px 15px; 
        font-weight: 500; 
        transition: 0.2s all ease;
        border-bottom: 2px solid transparent;
        border-radius: 0; 
        margin-bottom: 5px;
        display: flex;
        align-items: center;
    }
    .seller-sidebar .nav-link:hover { 
        color: #ea580c; 
        background-color: #fff7ed;
    }
    .seller-sidebar .nav-link.active { 
        color: #ea580c; 
        border-bottom: 2px solid #ea580c; 
        font-weight: bold;
        background-color: #fff7ed;
    }
    .seller-sidebar .nav-link i { 
        margin-right: 10px; 
        width: 20px; 
        text-align: center; 
        font-size: 1.15rem;
    }
    .btn-seller-return-home {
        border: 1px solid #ea580c;
        color: #ea580c;
        background: transparent;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .btn-seller-return-home:hover {
        background-color: #ea580c;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(234, 88, 12, 0.25);
    }
</style>

<div class="seller-sidebar p-3 d-flex flex-column">
    <h4 class="text-center fw-bold mb-4 mt-2" style="color: #ea580c;">
        <i class="bi bi-shop me-2"></i>Kênh Người Bán
    </h4>
    <ul class="nav flex-column mb-auto">
        <li class="nav-item">
            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" 
               asp-area="Seller" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Tổng quan
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentController == "Food" ? "active" : "")" 
               asp-area="Seller" asp-controller="Food" asp-action="Index">
                <i class="bi bi-egg-fried"></i> Quản lý món ăn
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentController == "Order" ? "active" : "")" 
               asp-area="Seller" asp-controller="Order" asp-action="Index">
                <i class="bi bi-receipt"></i> Đơn đặt hàng
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentController == "Review" ? "active" : "")" 
               asp-area="Seller" asp-controller="Review" asp-action="Index">
                <i class="bi bi-star"></i> Đánh giá của khách hàng
            </a>
        </li>
        <li class="nav-item">
             <a class="nav-link fw-medium @(currentController == "Chat" ? "active" : "")"
                           asp-area="" asp-controller="Chat" asp-action="Index">
                <i class="bi bi-chat-dots"></i> Chat với khách hàng
            </a>
        </li>
    </ul>
    <hr class="text-secondary opacity-25">
    <div class="text-center mt-2">
        <a href="/" class="btn btn-seller-return-home w-100 rounded-pill py-2">
            <i class="bi bi-box-arrow-left me-2"></i> Trở về Trang chủ
        </a>
    </div>
</div>
