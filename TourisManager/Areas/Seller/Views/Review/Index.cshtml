@model TourisManager.Areas.Seller.Models.ReviewListViewModel

@{
    ViewData["Title"] = "Đánh giá của khách hàng";
    Layout = "~/Views/Shared/MyLayout.cshtml";
    var location = Model.Location ?? (ViewBag.Location as TourisManager.Core.Entities.Location);
}

@functions {
    public string GetRatingLabel(int rating)
    {
        return rating switch
        {
            5 => "Xuất sắc",
            4 => "Hài lòng",
            3 => "Bình thường",
            2 => "Chưa hài lòng",
            1 => "Không tốt",
            _ => "Đánh giá"
        };
    }

    public string GetRatingBadgeClass(int rating)
    {
        return rating switch
        {
            5 => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
            4 => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
            3 => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
            2 => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
            1 => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }
}

<style>
    .review-score-box {
        background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
        border: 1px solid #fed7aa;
    }
    .rating-bar-progress {
        height: 10px;
        border-radius: 999px;
        background-color: #f1f5f9;
        overflow: hidden;
    }
    .rating-bar-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #f59e0b, #ea580c);
        transition: width 0.4s ease;
    }
    .filter-chip {
        color: #495057;
        font-weight: 500;
        padding: 8px 18px;
        border-radius: 50rem;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.9rem;
    }
    .filter-chip:hover {
        background-color: #fff7ed;
        color: #ea580c;
        border-color: #ea580c;
    }
    .filter-chip.active {
        background: linear-gradient(135deg, #ea580c, #f97316);
        color: #ffffff !important;
        border-color: #ea580c;
        box-shadow: 0 4px 10px rgba(234, 88, 12, 0.25);
    }
    .filter-chip.active .badge {
        background-color: rgba(255, 255, 255, 0.3) !important;
        color: #ffffff !important;
    }
    .review-card {
        border-radius: 1rem;
        border: 1px solid #f1f5f9;
        transition: all 0.2s ease;
        background: #ffffff;
    }
    .review-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06) !important;
        border-color: #e2e8f0;
    }
    .avatar-initial {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ea580c, #fb923c);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.15rem;
    }
    .star-gold {
        color: #f59e0b;
    }
    .star-gray {
        color: #cbd5e1;
    }
    .review-text-bubble {
        background-color: #f8fafc;
        border-radius: 0.75rem;
        border: 1px solid #f1f5f9;
        padding: 1rem 1.25rem;
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="row">
        <!-- CỘT TRÁI: Sidebar Điều hướng chung -->
        <div class="col-lg-3 col-md-4 mb-4">
            <partial name="_SellerSidebar" />
        </div>

        <!-- CỘT PHẢI: Nội dung Quản lý đánh giá -->
        <div class="col-lg-9 col-md-8 px-4">
            <!-- Thông báo TempData -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Tiêu đề trang & Nút hành động -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold text-dark mb-1">
                        <i class="bi bi-star-fill text-warning me-2"></i>Đánh giá của khách hàng
                    </h2>
                    <p class="text-muted small mb-0">
                        Theo dõi nhận xét, mức độ hài lòng và đóng góp ý kiến từ thực khách cho quán: 
                        <strong>@(location?.Name ?? "Quán ăn của bạn")</strong>
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold shadow-sm" title="Tải lại danh sách">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </a>
                    @if (location != null)
                    {
                        <a href="/Location/Details?id=@location.LocationId" target="_blank" class="btn rounded-pill px-3 py-2 fw-semibold text-white shadow-sm" style="background: linear-gradient(135deg, #ea580c, #f97316); border: none;">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Xem trang quán
                        </a>
                    }
                </div>
            </div>

            <!-- BẢNG TỔNG QUAN XẾP HẠNG & PHÂN BỔ SAO -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <div class="row align-items-center g-4">
                    <!-- Khối điểm trung bình -->
                    <div class="col-md-5 col-lg-4 text-center border-end-md">
                        <div class="review-score-box rounded-4 p-4 h-100 d-flex flex-column justify-content-center align-items-center shadow-sm">
                            <span class="text-muted fw-semibold small text-uppercase">Điểm đánh giá trung bình</span>
                            <div class="display-3 fw-bold my-2" style="color: #ea580c;">
                                @(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "5.0")
                            </div>
                            <div class="mb-2 fs-5">
                                @{
                                    var displayRating = Model.AverageRating > 0 ? Model.AverageRating : 5.0;
                                    int fullStars = (int)Math.Floor(displayRating);
                                    bool hasHalf = (displayRating - fullStars) >= 0.4;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= fullStars)
                                    {
                                        <i class="bi bi-star-fill star-gold"></i>
                                    }
                                    else if (i == fullStars + 1 && hasHalf)
                                    {
                                        <i class="bi bi-star-half star-gold"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star-fill star-gray"></i>
                                    }
                                }
                            </div>
                            <div class="text-secondary fw-semibold">
                                Dựa trên <strong>@Model.TotalReviews</strong> lượt đánh giá
                            </div>
                            <div class="mt-2 badge rounded-pill px-3 py-1 bg-white text-dark border shadow-sm small">
                                <i class="bi bi-hand-thumbs-up-fill text-success me-1"></i>
                                @Model.PositiveRatingPercentage% thực khách hài lòng
                            </div>
                        </div>
                    </div>

                    <!-- Khối thanh phân bổ 5 -> 1 sao -->
                    <div class="col-md-7 col-lg-8">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-bar-chart-line-fill text-secondary me-2"></i>Phân bổ đánh giá theo số sao
                        </h6>
                        <div class="d-flex flex-column gap-2">
                            @for (int star = 5; star >= 1; star--)
                            {
                                int starCount = star switch
                                {
                                    5 => Model.Count5Star,
                                    4 => Model.Count4Star,
                                    3 => Model.Count3Star,
                                    2 => Model.Count2Star,
                                    1 => Model.Count1Star,
                                    _ => 0
                                };
                                int pct = Model.GetRatingPercentage(star);
                                bool isCurrentStar = Model.SelectedRating == star;

                                <a asp-action="Index" 
                                   asp-route-rating="@(isCurrentStar ? null : star)" 
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-sort="@Model.SortBy"
                                   class="text-decoration-none text-dark d-flex align-items-center gap-3 p-1 rounded-2 transition" 
                                   style="@(isCurrentStar ? "background-color: #fff7ed;" : "")"
                                   title="Xem các đánh giá @star sao">
                                    <span class="fw-semibold text-secondary text-nowrap" style="width: 55px;">
                                        @star <i class="bi bi-star-fill star-gold ms-1"></i>
                                    </span>
                                    <div class="flex-grow-1 rating-bar-progress">
                                        <div class="rating-bar-fill" style="width: @(pct)%;"></div>
                                    </div>
                                    <span class="text-muted small text-end text-nowrap" style="width: 80px;">
                                        <strong>@starCount</strong> (@(pct)%)
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- THANH LỌC CHIP THEO SỐ SAO -->
            <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
                <span class="text-muted small fw-semibold me-2"><i class="bi bi-funnel-fill me-1"></i>Lọc theo sao:</span>
                
                <a asp-action="Index" 
                   asp-route-search="@Model.SearchTerm" 
                   asp-route-sort="@Model.SortBy"
                   class="filter-chip @(!Model.SelectedRating.HasValue ? "active" : "")">
                    Tất cả <span class="badge bg-light text-secondary rounded-pill ms-1">@Model.TotalReviews</span>
                </a>

                <a asp-action="Index" 
                   asp-route-rating="5" 
                   asp-route-search="@Model.SearchTerm" 
                   asp-route-sort="@Model.SortBy"
                   class="filter-chip @(Model.SelectedRating == 5 ? "active" : "")">
                    5 Sao <i class="bi bi-star-fill star-gold ms-1"></i> <span class="badge bg-light text-secondary rounded-pill ms-1">@Model.Count5Star</span>
                </a>

                <a asp-action="Index" 
                   asp-route-rating="4" 
                   asp-route-search="@Model.SearchTerm" 
                   asp-route-sort="@Model.SortBy"
                   class="filter-chip @(Model.SelectedRating == 4 ? "active" : "")">
                    4 Sao <i class="bi bi-star-fill star-gold ms-1"></i> <span class="badge bg-light text-secondary rounded-pill ms-1">@Model.Count4Star</span>
                </a>

                <a asp-action="Index" 
                   asp-route-rating="3" 
                   asp-route-search="@Model.SearchTerm" 
                   asp-route-sort="@Model.SortBy"
                   class="filter-chip @(Model.SelectedRating == 3 ? "active" : "")">
                    3 Sao <i class="bi bi-star-fill star-gold ms-1"></i> <span class="badge bg-light text-secondary rounded-pill ms-1">@Model.Count3Star</span>
                </a>

                <a asp-action="Index" 
                   asp-route-rating="2" 
                   asp-route-search="@Model.SearchTerm" 
                   asp-route-sort="@Model.SortBy"
                   class="filter-chip @(Model.SelectedRating == 2 ? "active" : "")">
                    2 Sao <i class="bi bi-star-fill star-gold ms-1"></i> <span class="badge bg-light text-secondary rounded-pill ms-1">@Model.Count2Star</span>
                </a>

                <a asp-action="Index" 
                   asp-route-rating="1" 
                   asp-route-search="@Model.SearchTerm" 
                   asp-route-sort="@Model.SortBy"
                   class="filter-chip @(Model.SelectedRating == 1 ? "active" : "")">
                    1 Sao <i class="bi bi-star-fill star-gold ms-1"></i> <span class="badge bg-light text-secondary rounded-pill ms-1">@Model.Count1Star</span>
                </a>
            </div>

            <!-- THANH TÌM KIẾM & SẮP XẾP -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
                <form method="get" asp-action="Index" class="row g-2 align-items-center">
                    @if (Model.SelectedRating.HasValue)
                    {
                        <input type="hidden" name="rating" value="@Model.SelectedRating.Value" />
                    }

                    <div class="col-md-6 col-lg-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control bg-light border-0" 
                                   placeholder="Tìm kiếm nội dung nhận xét hoặc tên thực khách..." 
                                   value="@Model.SearchTerm" />
                        </div>
                    </div>

                    <div class="col-md-4 col-lg-3">
                        <select name="sort" class="form-select bg-light border-0" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">Mới nhất</option>
                            <option value="oldest" selected="@(Model.SortBy == "oldest" ? "selected" : null)">Cũ nhất</option>
                            <option value="highest" selected="@(Model.SortBy == "highest" ? "selected" : null)">Đánh giá cao nhất (5★ → 1★)</option>
                            <option value="lowest" selected="@(Model.SortBy == "lowest" ? "selected" : null)">Đánh giá thấp nhất (1★ → 5★)</option>
                        </select>
                    </div>

                    <div class="col-md-2 col-lg-2 d-flex gap-2">
                        <button type="submit" class="btn rounded-pill px-3 flex-grow-1 shadow-sm text-white fw-semibold" style="background: linear-gradient(135deg, #ea580c, #f97316); border: none;">
                            <i class="bi bi-funnel me-1"></i> Lọc
                        </button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedRating.HasValue)
                        {
                            <a asp-action="Index" class="btn btn-light rounded-pill px-3" title="Xóa bộ lọc">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                    </div>
                </form>
            </div>

            <!-- DANH SÁCH CHI TIẾT ĐÁNH GIÁ -->
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var review in Model.Reviews)
                    {
                        var authorName = string.IsNullOrWhiteSpace(review.Account?.Name) ? "Thực khách" : review.Account.Name;
                        var avatarUrl = review.Account?.AvataUrl;
                        var initialLetter = string.IsNullOrWhiteSpace(authorName) ? "K" : authorName.Substring(0, 1).ToUpper();

                        <div class="card review-card shadow-sm p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <!-- Khách hàng info -->
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="@authorName" class="rounded-circle object-fit-cover shadow-sm border" style="width: 48px; height: 48px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="avatar-initial shadow-sm" style="display: none;">@initialLetter</div>
                                    }
                                    else
                                    {
                                        <div class="avatar-initial shadow-sm">@initialLetter</div>
                                    }
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="fw-bold text-dark mb-0">@authorName</h6>
                                            <span class="badge @GetRatingBadgeClass(review.Rating) rounded-pill small px-2.5 py-1">
                                                @review.Rating <i class="bi bi-star-fill small"></i> - @GetRatingLabel(review.Rating)
                                            </span>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-clock me-1"></i>@review.CreateAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>

                                <!-- Thao tác đánh giá -->
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-area="" asp-controller="Chat" asp-action="Index" 
                                       class="btn btn-sm btn-light border rounded-pill px-3 text-secondary"
                                       title="Mở kênh trò chuyện với khách">
                                        <i class="bi bi-chat-dots me-1"></i> Nhắn tin
                                    </a>
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-delete-review"
                                            data-id="@review.ReviewId"
                                            data-author="@authorName"
                                            data-content="@(review.Content ?? "")"
                                            title="Xóa đánh giá này">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                </div>
                            </div>

                            <!-- Xếp hạng sao chi tiết -->
                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="bi bi-star-fill star-gold fs-6 me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star-fill star-gray fs-6 me-1"></i>
                                    }
                                }
                            </div>

                            <!-- Nội dung nhận xét -->
                            @if (!string.IsNullOrWhiteSpace(review.Content))
                            {
                                <div class="review-text-bubble mt-2">
                                    <p class="mb-0 text-dark" style="white-space: pre-line; line-height: 1.6;">@review.Content</p>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted fst-italic small mt-1">
                                    <i class="bi bi-chat-square-text me-1"></i>Khách hàng chỉ chấm điểm sao, không kèm bình luận chữ.
                                </div>
                            }

                            <!-- Hình ảnh đính kèm (nếu có) -->
                            @if (!string.IsNullOrWhiteSpace(review.ImageUrl))
                            {
                                <div class="mt-3">
                                    <img src="@review.ImageUrl" 
                                         alt="Ảnh đính kèm đánh giá" 
                                         class="rounded-3 border shadow-sm object-fit-cover" 
                                         style="max-width: 160px; max-height: 160px; cursor: pointer;"
                                         onclick="showImagePreview('@review.ImageUrl')" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- TRẠNG THÁI TRỐNG (CHƯA CÓ ĐÁNH GIÁ) -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center">
                    <div class="mb-3">
                        <div class="d-inline-flex p-4 rounded-circle" style="background-color: #fff7ed; color: #ea580c;">
                            <i class="bi bi-star display-4"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Chưa có đánh giá nào phù hợp</h5>
                    <p class="text-muted small mx-auto mb-4" style="max-width: 480px;">
                        @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedRating.HasValue)
                        {
                            <span>Không tìm thấy đánh giá nào theo bộ lọc đang chọn. Bạn có thể xóa bộ lọc để xem lại tất cả đánh giá.</span>
                        }
                        else
                        {
                            <span>Hiện tại quán ăn của bạn chưa nhận được đánh giá nào từ thực khách. Hãy chia sẻ gian hàng và phục vụ các món ăn ngon để nhận được nhiều đánh giá 5 sao nhé!</span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedRating.HasValue)
                    {
                        <div>
                            <a asp-action="Index" class="btn rounded-pill px-4 py-2 shadow-sm text-white fw-semibold" style="background: linear-gradient(135deg, #ea580c, #f97316); border: none;">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc tìm kiếm
                            </a>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL XÁC NHẬN XÓA ĐÁNH GIÁ -->
<!-- ======================================================== -->
<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-labelledby="deleteReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteReviewId" value="" />

                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-danger" id="deleteReviewModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa đánh giá
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-2">
                        Bạn có chắc chắn muốn xóa đánh giá của thực khách <strong id="deleteReviewAuthor" class="text-dark"></strong> không?
                    </p>
                    <div id="deleteReviewPreview" class="review-text-bubble small text-muted fst-italic mb-3" style="display: none;"></div>
                    <div class="alert alert-warning border-0 small rounded-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Hành động này sẽ xóa vĩnh viễn đánh giá và cập nhật lại điểm trung bình của quán.
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-trash3 me-1"></i> Xóa vĩnh viễn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL XEM ẢNH PHÓNG TO -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 bg-transparent">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0">
                <img id="modalPreviewImg" src="" class="img-fluid rounded-4 shadow-lg" alt="Phóng to ảnh" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Mở modal xác nhận xóa đánh giá
            $('.btn-delete-review').on('click', function () {
                var reviewId = $(this).data('id');
                var author = $(this).data('author');
                var content = $(this).data('content');

                $('#deleteReviewId').val(reviewId);
                $('#deleteReviewAuthor').text(author);

                if (content && content.trim() !== '') {
                    $('#deleteReviewPreview').text('"' + content + '"').show();
                } else {
                    $('#deleteReviewPreview').hide();
                }

                var modal = new bootstrap.Modal(document.getElementById('deleteReviewModal'));
                modal.show();
            });
        });

        function showImagePreview(url) {
            $('#modalPreviewImg').attr('src', url);
            var modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            modal.show();
        }
    </script>
}
