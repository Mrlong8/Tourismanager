@model TourisManager.Core.Entities.Location

@{
    ViewData["Title"] = "Quản lý gian hàng";
    Layout = "~/Views/Shared/MyLayout.cshtml";
    int foodCount = ViewBag.FoodCount ?? 0;
    int orderCount = ViewBag.OrderCount ?? 0;
    int pendingOrderCount = ViewBag.PendingOrderCount ?? 0;
    decimal revenue = ViewBag.Revenue ?? 0m;
}

@section Styles {
    <!-- Leaflet CSS để hiển thị bản đồ định vị ghim quán -->
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
}

<div class="container-fluid mt-4 mb-5">
    <div class="row">
        
        <!-- CỘT TRÁI: Sidebar Điều hướng chung -->
        <div class="col-lg-3 col-md-4 mb-4">
            <partial name="_SellerSidebar" />
        </div>

        <!-- CỘT PHẢI: Nội dung chính (Main Content) -->
        <div class="col-lg-9 col-md-8 px-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold text-dark mb-0">Tổng quan thông tin</h2>
                    <p class="text-muted small mb-0 mt-1">Quản lý toàn bộ thông tin nhà hàng, món ăn và đơn hàng của quán</p>
                </div>
                <div class="badge p-2 fs-6 rounded-pill px-3 shadow-sm text-white" style="background: linear-gradient(135deg, #ea580c, #f97316);">
                    <i class="bi bi-circle-fill small me-1"></i> Đang hoạt động
                </div>
            </div>

            <div class="row">
                <!-- Thẻ hiển thị thông tin chi tiết nhà hàng -->
                <div class="col-xl-7 col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                            <h5 class="fw-bold text-dark"><i class="bi bi-info-circle me-2" style="color: #ea580c;"></i>Hồ sơ Quán ăn</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex flex-column flex-sm-row gap-3 align-items-center mb-4 pb-3 border-bottom">
                                <div class="position-relative flex-shrink-0" style="width: 110px; height: 110px;">
                                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/Image/Upload/avatadefault.jpg" : Model.ImageUrl)" 
                                         onerror="this.onerror=null; this.src='/Image/Upload/avatadefault.jpg';"
                                         class="w-100 h-100 rounded-3 object-fit-cover border shadow-sm" 
                                         alt="@Model.Name" />
                                </div>
                                <div class="w-100">
                                    <h4 class="fw-bold text-dark mb-1">@Model.Name</h4>
                                    <div class="text-secondary small mb-2"><i class="bi bi-geo-alt me-1 text-danger"></i>@Model.Address</div>
                                    @if (Model.Latitude != 0 && Model.Longitude != 0)
                                    {
                                        <span class="badge px-3 py-1 rounded-pill fw-medium small" style="background-color: #fff7ed; color: #ea580c; border: 1px solid #fed7aa;">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>Đã ghim: @Model.Latitude.ToString("F6"), @Model.Longitude.ToString("F6")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1 rounded-pill fw-medium small">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Chưa ghim vị trí quán
                                        </span>
                                    }
                                </div>
                            </div>

                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <th style="width: 35%;" class="text-muted ps-0">Ngày tham gia:</th>
                                        <td>@Model.CreateAt.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted ps-0">Mô tả:</th>
                                        <td class="text-secondary">@(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả..." : Model.Description)</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="mt-4 pt-3 border-top">
                                <button type="button" class="btn px-4 rounded-pill shadow-sm text-white fw-semibold" style="background: linear-gradient(135deg, #ea580c, #f97316); border: none;" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                                    <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa hồ sơ & Ghim vị trí
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thống kê nhanh bên phải -->
                <div class="col-xl-5 col-lg-6 mb-4">
                    <div class="row g-3 h-100">
                        <!-- Thẻ Món ăn trên thực đơn -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4 text-center p-3 text-white" style="background: linear-gradient(135deg, #ea580c, #f97316);">
                                <div class="card-body d-flex flex-column justify-content-center p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-white-50 fw-semibold text-uppercase small">Thực đơn của quán</span>
                                        <i class="bi bi-egg-fried fs-3 text-white-50"></i>
                                    </div>
                                    <h1 class="display-4 fw-bold mb-0">@foodCount</h1>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-white border-opacity-25">
                                        <small class="text-white-50">Món ăn sẵn sàng phục vụ</small>
                                        <a asp-area="Seller" asp-controller="Food" asp-action="Index" class="btn btn-sm btn-light fw-bold rounded-pill px-3 shadow-sm" style="color: #ea580c;">
                                            Quản lý món <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Thẻ Đơn hàng & Doanh thu nhỏ -->
                        <div class="col-sm-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-muted small fw-semibold">Đơn đặt hàng</span>
                                        <div class="p-2 rounded-3" style="background-color: #fff7ed; color: #ea580c;">
                                            <i class="bi bi-receipt"></i>
                                        </div>
                                    </div>
                                    <div class="my-2">
                                        <h3 class="fw-bold mb-0 text-dark">@orderCount</h3>
                                        <small class="text-warning fw-semibold">@pendingOrderCount đơn chờ duyệt</small>
                                    </div>
                                    <a asp-area="Seller" asp-controller="Order" asp-action="Index" class="text-decoration-none small fw-semibold" style="color: #ea580c;">
                                        Xem đơn hàng <i class="bi bi-chevron-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-muted small fw-semibold">Doanh thu quán</span>
                                        <div class="p-2 rounded-3" style="background-color: #fff7ed; color: #ea580c;">
                                            <i class="bi bi-cash-stack"></i>
                                        </div>
                                    </div>
                                    <div class="my-2">
                                        <h3 class="fw-bold mb-0" style="color: #ea580c;">@revenue.ToString("N0") <span class="fs-6">đ</span></h3>
                                        <small class="text-muted">Đơn đã hoàn thành</small>
                                    </div>
                                    <a asp-area="Seller" asp-controller="Order" asp-action="Index" class="text-decoration-none small fw-semibold" style="color: #ea580c;">
                                        Chi tiết <i class="bi bi-chevron-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Khối gợi ý hành động nhanh cho người bán -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mt-2">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Thao tác nhanh cho Người bán</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <a asp-area="Seller" asp-controller="Food" asp-action="Index" class="card border text-decoration-none rounded-3 p-3 h-100 text-dark hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-3 rounded-circle" style="background-color: #fff7ed; color: #ea580c;">
                                    <i class="bi bi-plus-circle-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">Thêm món ăn mới</div>
                                    <small class="text-muted">Cập nhật thực đơn quán ăn</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-area="Seller" asp-controller="Order" asp-action="Index" class="card border text-decoration-none rounded-3 p-3 h-100 text-dark hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                                    <i class="bi bi-clock-history fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">Xử lý đơn đặt hàng</div>
                                    <small class="text-muted">Xác nhận và giao món</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#editProfileModal" class="card border text-decoration-none rounded-3 p-3 h-100 text-dark hover-shadow transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                                    <i class="bi bi-geo-alt-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">Cập nhật vị trí quán</div>
                                    <small class="text-muted">Ghim địa chỉ trên bản đồ</small>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

        </div>
        
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL CHỈNH SỬA HỒ SƠ QUÁN ĂN & GHIM VỊ TRÍ BẢN ĐỒ -->
<!-- ======================================================== -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="UpdateProfile" method="post" id="editProfileForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LocationId" value="@Model.LocationId" />
                <input type="hidden" name="Latitude" id="sellerEditLat" value="@Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <input type="hidden" name="Longitude" id="sellerEditLng" value="@Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-dark" id="editProfileModalLabel">
                        <i class="bi bi-pencil-square me-2" style="color: #ea580c;"></i>Chỉnh sửa hồ sơ & Ghim vị trí Quán ăn
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Tên nhà hàng -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary">Tên nhà hàng / Quán ăn <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control rounded-3" value="@Model.Name" required />
                        </div>

                        <!-- Hình ảnh quán ăn -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary">Hình ảnh Quán ăn</label>
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex flex-column flex-sm-row align-items-center gap-3">
                                    <div class="position-relative flex-shrink-0" style="width: 110px; height: 110px;">
                                        <img id="editStoreImgPreview" 
                                             src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/Image/Upload/avatadefault.jpg" : Model.ImageUrl)" 
                                             onerror="this.onerror=null; this.src='/Image/Upload/avatadefault.jpg';"
                                             class="w-100 h-100 rounded-3 object-fit-cover border shadow-sm" 
                                             alt="Ảnh quán ăn" />
                                    </div>
                                    <div class="flex-grow-1 w-100">
                                        <label class="form-label fw-semibold small text-muted mb-1">
                                            <i class="bi bi-cloud-arrow-up me-1" style="color: #ea580c;"></i>Tải ảnh mới từ thiết bị
                                        </label>
                                        <input type="file" name="imageFile" id="editStoreImgInput" class="form-control form-control-sm rounded-3 mb-2" accept="image/*" />
                                        <input type="text" name="ImageUrl" id="editStoreImageUrl" class="form-control form-control-sm rounded-3" value="@Model.ImageUrl" placeholder="Hoặc dán URL hình ảnh quán ăn..." />
                                        <div class="form-text text-muted small mt-1" style="font-size: 0.78rem;">
                                            <i class="bi bi-info-circle me-1"></i>Hỗ trợ định dạng JPG, PNG, WEBP (Ảnh hiển thị trên trang chủ và trang chi tiết của quán)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Địa chỉ chi tiết kèm công cụ tìm kiếm và định vị GPS -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" name="Address" id="sellerEditAddress" class="form-control rounded-start-3" value="@Model.Address" placeholder="Nhập số nhà, tên đường, quận/huyện..." required />
                                <button type="button" class="btn fw-semibold" style="border: 1px solid #ea580c; color: #ea580c;" id="btnSearchAddress" title="Tìm và nhảy đến vị trí trên bản đồ">
                                    <i class="bi bi-search me-1"></i> Tìm vị trí
                                </button>
                                <button type="button" class="btn btn-outline-primary" id="btnGetLocation" title="Lấy tọa độ vị trí hiện tại của thiết bị">
                                    <i class="bi bi-crosshair me-1"></i> Định vị tôi
                                </button>
                            </div>
                            <div id="addressSearchStatus" class="small text-muted mt-1 d-none">
                                <span class="spinner-border spinner-border-sm me-1" style="color: #ea580c;"></span>
                                <span id="addressSearchText">Đang tìm vị trí trên bản đồ...</span>
                            </div>
                        </div>

                        <!-- KHUNG BẢN ĐỒ GHIM VỊ TRÍ -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold text-secondary mb-0">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Ghim vị trí quán trên bản đồ
                                </label>
                                <span class="badge rounded-pill px-3 py-1 fw-semibold small" style="background-color: #fff7ed; color: #ea580c; border: 1px solid #fed7aa;" id="sellerEditCoordsText">
                                    @(Model.Latitude != 0 ? $"Tọa độ: {Model.Latitude:F6}, {Model.Longitude:F6}" : "Chưa chọn tọa độ")
                                </span>
                            </div>
                            <small class="text-muted d-block mb-2" style="font-size: 0.83rem;">
                                <i class="bi bi-hand-index-thumb text-primary me-1"></i> 
                                Bạn có thể <strong>nhấp trực tiếp</strong> lên bản đồ hoặc <strong>kéo rê ghim</strong> để xác định chính xác vị trí quán của mình.
                            </small>
                            <div id="sellerEditMap" style="height: 280px; width: 100%; border-radius: 12px; z-index: 1;" class="border shadow-sm"></div>
                        </div>

                        <!-- Mô tả quán -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary">Mô tả giới thiệu quán</label>
                            <textarea name="Description" class="form-control rounded-3" rows="3" placeholder="Giới thiệu đôi nét về quán ăn...">@Model.Description</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn rounded-pill px-4 shadow-sm fw-semibold text-white" style="background: linear-gradient(135deg, #ea580c, #f97316); border: none;">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet JS -->
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>

    <script>
        let editMap, editMarker;
        let reverseTimeout = null;

        // Tọa độ khởi tạo
        const initialLat = parseFloat('@Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)') || 21.028511;
        const initialLng = parseFloat('@Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)') || 105.854167;
        const hasCoords = (parseFloat('@Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)') !== 0);

        // Khởi tạo bản đồ khi Modal được mở
        $('#editProfileModal').on('shown.bs.modal', function () {
            if (!editMap) {
                initSellerMap(initialLat, initialLng, hasCoords);
            } else {
                setTimeout(function () {
                    editMap.invalidateSize();
                    if (editMarker) {
                        editMap.setView(editMarker.getLatLng(), hasCoords ? 16 : 14);
                    }
                }, 200);
            }
        });

        function initSellerMap(lat, lng, isAlreadyPinned) {
            const mapContainer = document.getElementById('sellerEditMap');
            if (!mapContainer || typeof L === 'undefined') return;

            // Đảm bảo icon marker chuẩn của Leaflet hiển thị đúng
            if (L.Icon && L.Icon.Default) {
                delete L.Icon.Default.prototype._getIconUrl;
                L.Icon.Default.mergeOptions({
                    iconRetinaUrl: '/lib/leaflet/images/marker-icon-2x.png',
                    iconUrl: '/lib/leaflet/images/marker-icon.png',
                    shadowUrl: '/lib/leaflet/images/marker-shadow.png'
                });
            }

            editMap = L.map('sellerEditMap', { zoomControl: true, scrollWheelZoom: true })
                .setView([lat, lng], isAlreadyPinned ? 16 : 14);

            // Dùng dữ liệu bản đồ Google Maps sắc nét giống trang chủ
            const googleLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
                maxZoom: 20,
                subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
                attribution: '&copy; Google Maps'
            });

            const osmLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            });

            googleLayer.on('tileerror', function () {
                editMap.removeLayer(googleLayer);
                osmLayer.addTo(editMap);
            });
            googleLayer.addTo(editMap);

            // Tạo ghim vị trí cho phép kéo rê (draggable: true)
            editMarker = L.marker([lat, lng], { draggable: true }).addTo(editMap);
            editMarker.bindPopup('<strong><i class="bi bi-geo-alt-fill text-danger"></i> Vị trí quán ăn của bạn</strong><br/><small class="text-muted">Kéo ghim hoặc bấm bản đồ để đổi vị trí</small>').openPopup();

            // Cập nhật khi kéo marker
            editMarker.on('dragend', function () {
                const pos = editMarker.getLatLng();
                updateSellerCoords(pos.lat, pos.lng, true);
            });

            // Cập nhật khi nhấp vào bản đồ
            editMap.on('click', function (e) {
                editMarker.setLatLng(e.latlng);
                updateSellerCoords(e.latlng.lat, e.latlng.lng, true);
                editMarker.openPopup();
            });

            setTimeout(function () {
                editMap.invalidateSize();
            }, 300);
        }

        // Cập nhật tọa độ vào hidden inputs và nhãn hiển thị
        function updateSellerCoords(lat, lng, fetchAddress) {
            $('#sellerEditLat').val(lat.toFixed(6));
            $('#sellerEditLng').val(lng.toFixed(6));
            $('#sellerEditCoordsText').html('<i class="bi bi-check-circle-fill me-1" style="color: #ea580c;"></i>Tọa độ: ' + lat.toFixed(6) + ', ' + lng.toFixed(6));

            if (fetchAddress) {
                clearTimeout(reverseTimeout);
                reverseTimeout = setTimeout(function () {
                    reverseGeocodeSeller(lat, lng);
                }, 400);
            }
        }

        // Tự động tìm tên địa chỉ tương ứng khi kéo ghim
        function reverseGeocodeSeller(lat, lng) {
            const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=18&accept-language=vi&lat=${lat}&lon=${lng}`;
            fetch(url)
                .then(res => res.json())
                .then(data => {
                    if (data && data.display_name) {
                        const addrInput = $('#sellerEditAddress');
                        // Nếu ô địa chỉ đang trống thì tự điền
                        if (!addrInput.val() || addrInput.val().trim() === '') {
                            addrInput.val(data.display_name);
                        }
                    }
                })
                .catch(err => console.warn('Lỗi reverse geocoding:', err));
        }

        // Tìm vị trí theo địa chỉ mà người dùng nhập
        $('#btnSearchAddress').on('click', function () {
            searchAddressOnMap();
        });

        $('#sellerEditAddress').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                searchAddressOnMap();
            }
        });

        function searchAddressOnMap() {
            const query = $('#sellerEditAddress').val().trim();
            if (!query) {
                alert('Vui lòng nhập địa chỉ cần tìm kiếm!');
                return;
            }

            const statusDiv = $('#addressSearchStatus');
            const statusText = $('#addressSearchText');
            statusDiv.removeClass('d-none');
            statusText.text('Đang tìm kiếm vị trí: ' + query + '...');

            const url = `https://nominatim.openstreetmap.org/search?format=json&accept-language=vi&countrycodes=vn&limit=1&q=${encodeURIComponent(query)}`;
            
            fetch(url)
                .then(res => res.json())
                .then(results => {
                    statusDiv.addClass('d-none');
                    if (results && results.length > 0) {
                        const lat = parseFloat(results[0].lat);
                        const lng = parseFloat(results[0].lon);

                        if (editMap && editMarker) {
                            editMap.setView([lat, lng], 17);
                            editMarker.setLatLng([lat, lng]);
                            editMarker.bindPopup('<strong>' + (results[0].display_name || query) + '</strong>').openPopup();
                        }
                        updateSellerCoords(lat, lng, false);
                    } else {
                        // Thử tìm với Photon nếu Nominatim không thấy
                        searchPhoton(query);
                    }
                })
                .catch(err => {
                    statusDiv.addClass('d-none');
                    console.warn('Lỗi tìm kiếm Nominatim:', err);
                    searchPhoton(query);
                });
        }

        function searchPhoton(query) {
            const statusDiv = $('#addressSearchStatus');
            const statusText = $('#addressSearchText');
            statusDiv.removeClass('d-none');
            statusText.text('Đang thử tìm kiếm mở rộng...');

            fetch(`https://photon.komoot.io/api/?limit=1&lat=21.0285&lon=105.8048&q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(data => {
                    statusDiv.addClass('d-none');
                    const feat = data && data.features && data.features[0];
                    if (feat && feat.geometry && feat.geometry.coordinates) {
                        const lng = feat.geometry.coordinates[0];
                        const lat = feat.geometry.coordinates[1];

                        if (editMap && editMarker) {
                            editMap.setView([lat, lng], 17);
                            editMarker.setLatLng([lat, lng]);
                            editMarker.bindPopup('<strong>' + query + '</strong>').openPopup();
                        }
                        updateSellerCoords(lat, lng, false);
                    } else {
                        alert('Không tìm thấy vị trí khớp với địa chỉ vừa nhập. Vui lòng thử từ khóa ngắn gọn hơn hoặc ghim trực tiếp trên bản đồ.');
                    }
                })
                .catch(err => {
                    statusDiv.addClass('d-none');
                    alert('Không tìm thấy vị trí. Vui lòng nhấp trực tiếp vào bản đồ để ghim vị trí quán!');
                });
        }

        // Định vị GPS của thiết bị
        $('#btnGetLocation').on('click', function () {
            if (!navigator.geolocation) {
                alert('Trình duyệt của bạn không hỗ trợ định vị GPS.');
                return;
            }

            const btn = $(this);
            const originalHtml = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang định vị...');

            navigator.geolocation.getCurrentPosition(
                function (position) {
                    btn.prop('disabled', false).html(originalHtml);
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    if (editMap && editMarker) {
                        editMap.setView([lat, lng], 17);
                        editMarker.setLatLng([lat, lng]);
                        editMarker.bindPopup('<strong><i class="bi bi-geo-alt-fill text-primary"></i> Vị trí GPS hiện tại của bạn</strong>').openPopup();
                    }
                    updateSellerCoords(lat, lng, true);
                },
                function (error) {
                    btn.prop('disabled', false).html(originalHtml);
                    alert('Không thể lấy vị trí GPS hiện tại. Vui lòng cho phép quyền truy cập vị trí trên trình duyệt hoặc ghim vị trí trên bản đồ.');
                },
                { enableHighAccuracy: true, timeout: 8000, maximumAge: 30000 }
            );
        });

        // Xem trước ảnh quán ăn khi chọn file mới từ thiết bị
        $('#editStoreImgInput').on('change', function () {
            var file = this.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#editStoreImgPreview').attr('src', e.target.result);
                };
                reader.readAsDataURL(file);
            }
        });

        // Xem trước ảnh quán ăn khi gõ hoặc dán URL
        $('#editStoreImageUrl').on('input', function () {
            var url = $(this).val().trim();
            if (url) {
                $('#editStoreImgPreview').attr('src', url);
            }
        });
    </script>
}
