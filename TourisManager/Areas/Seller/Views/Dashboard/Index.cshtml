@model TourisManager.Core.Entities.Location

@{
    ViewData["Title"] = "Quản lý gian hàng";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<style>
    /* CSS cho Sidebar phong cách nền trắng, gạch chân */
    .seller-sidebar { 
        background-color: #ffffff; 
        border-right: 1px solid #e0e0e0;
        min-height: 80vh; 
    }
    .seller-sidebar .nav-link { 
        color: #495057; 
        padding: 12px 15px; 
        font-weight: 500; 
        transition: 0.2s;
        border-bottom: 2px solid transparent; /* Chuẩn bị sẵn viền dưới trong suốt */
        border-radius: 0; 
        margin-bottom: 5px;
    }
    .seller-sidebar .nav-link:hover { 
        color: #00a65a; /* Đổi màu chữ xanh khi di chuột */
    }
    .seller-sidebar .nav-link.active { 
        color: #00a65a; 
        border-bottom: 2px solid #00a65a; /* Hiệu ứng gạch chân màu xanh khi active */
        font-weight: bold;
    }
    .seller-sidebar .nav-link i { margin-right: 10px; width: 20px; text-align: center; }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="row">
        
        <!-- CỘT TRÁI: Sidebar Điều hướng -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="seller-sidebar p-3 d-flex flex-column">
                <!-- Đã bỏ icon quán ăn và đổi màu chữ thành xanh lá -->
                <h4 class="text-success text-center fw-bold mb-4 mt-2">
                    Kênh Người Bán
                </h4>
                <ul class="nav flex-column mb-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#"><i class="bi bi-speedometer2"></i> Tổng quan</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-egg-fried"></i> Quản lý món ăn</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-receipt"></i> Đơn đặt hàng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-star"></i> Đánh giá khách hàng</a>
                    </li>
                </ul>
                <hr class="text-secondary opacity-25">
                <div class="text-center mt-2">
                    <a href="/" class="btn btn-outline-success w-100"><i class="bi bi-box-arrow-left me-2"></i> Trở về Trang chủ</a>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: Nội dung chính (Main Content) -->
        <div class="col-lg-9 col-md-8 px-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark mb-0">Tổng quan thông tin</h2>
                <div class="badge bg-success p-2 fs-6 rounded-pill">Đang hoạt động</div>
            </div>

            <div class="row">
                <!-- Thẻ hiển thị thông tin chi tiết nhà hàng -->
                <div class="col-xl-8 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                            <h5 class="fw-bold"><i class="bi bi-info-circle text-success me-2"></i>Hồ sơ Quán ăn</h5>
                        </div>
                        <div class="card-body p-4">
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <th style="width: 30%;" class="text-muted ps-0">Tên nhà hàng:</th>
                                        <td class="fw-bold fs-5 text-dark">@Model.Name</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted ps-0">Địa chỉ chi tiết:</th>
                                        <td>@Model.Address</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted ps-0">Ngày tham gia:</th>
                                        <td>@Model.CreateAt.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted ps-0">Mô tả:</th>
                                        <td>@(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả..." : Model.Description)</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="mt-4 pt-3 border-top">
                                <button class="btn btn-success px-4 rounded-pill"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa hồ sơ</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thẻ thống kê nhanh -->
                <div class="col-xl-4 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 text-center h-100 bg-success text-white">
                        <div class="card-body d-flex flex-column justify-content-center p-4">
                            <i class="bi bi-cup-hot display-4 mb-3 text-white-50"></i>
                            <h5 class="fw-bold mb-1">Món ăn trên thực đơn</h5>
                            <h1 class="display-3 fw-bold mb-0">0</h1>
                            <p class="mt-2 text-white-50 mb-0">Sẵn sàng phục vụ thực khách</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>