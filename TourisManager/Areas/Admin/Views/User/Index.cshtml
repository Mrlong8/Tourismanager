@model IEnumerable<TourisManager.Core.Entities.Account>

@{
    ViewData["Title"] = "Quản lý User";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="text-decoration-none text-primary">
        <i class="bi bi-people-fill me-2"></i>Quản lý User
    </a>
</h3>
            <p class="text-muted small mb-0">Quản lý danh sách tài khoản người dùng trong hệ thống</p>
        </div>
        <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm User
        </a>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary border-bottom">
                        <tr class="text-nowrap">
                            <th class="ps-4 py-3">Account ID</th>
                            <th class="py-3">Username</th>
                            <th class="py-3">Họ tên</th>
                            <th class="py-3">Email</th>
                            <th class="py-3 text-center">Role</th>
                            <th class="py-3 text-center">Auth Provider</th>
                            <th class="py-3 text-center">Ngày tạo</th>
                            <th class="pe-4 py-3 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <!-- Account ID -->
                                    <td class="ps-4 fw-semibold text-secondary">
                                        <span class="text-truncate d-inline-block" style="max-width: 120px;" title="@user.AccountId">
                                            @user.AccountId
                                        </span>
                                    </td>

                                    <!-- Username -->
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-person-circle text-muted me-1"></i>
                                        @(string.IsNullOrEmpty(user.Username) ? "N/A" : user.Username)
                                    </td>

                                    <!-- Họ tên -->
                                    <td>@(string.IsNullOrEmpty(user.Name) ? "Chưa cập nhật" : user.Name)</td>

                                    <!-- Email -->
                                    <td class="text-muted">
                                        <i class="bi bi-envelope me-1"></i>@user.Email
                                    </td>

                                    <!-- Role Badge -->
                                    <td class="text-center">
                                        @if (user.Role?.ToLower() == "admin")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">
                                                <i class="bi bi-shield-lock-fill me-1"></i>Admin
                                            </span>
                                        }
                                        else if (user.Role?.ToLower() == "seller")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2">
                                                <i class="bi bi-shop me-1"></i>Seller
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-2">
                                                <i class="bi bi-person me-1"></i>User
                                            </span>
                                        }
                                    </td>

                                    <!-- Auth Provider -->
                                    <td class="text-center">
                                        @if (user.AuthProvider?.ToLower() == "google")
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1">
                                                <i class="bi bi-google text-danger me-1"></i>Google
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-1">
                                                <i class="bi bi-key-fill me-1"></i>Local
                                            </span>
                                        }
                                    </td>

                                    <!-- Ngày tạo -->
                                    <td class="text-center text-muted small">
                                        @user.CreateAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- Thao tác -->
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.AccountId" class="btn btn-light text-warning" title="Sửa">
                                                <i class="bi bi-pencil-fill"></i> Sửa
                                            </a>
                                            <a asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@user.AccountId" class="btn btn-light text-danger" title="Xóa">
                                                <i class="bi bi-trash-fill"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2"></i>
                                    Chưa có người dùng nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>