@model TourisManager.Core.Entities.Account

@{
    ViewData["Title"] = "Xóa User";
}

<h1>Xóa User</h1>

<h3>Bạn có chắc chắn muốn xóa User này không?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Account ID
        </dt>
        <dd class="col-sm-10">
            @Model.AccountId
        </dd>

        <dt class="col-sm-2">
            Username
        </dt>
        <dd class="col-sm-10">
            @Model.Username
        </dd>

        <dt class="col-sm-2">
            Họ tên
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>

        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>

        <dt class="col-sm-2">
            Role
        </dt>
        <dd class="col-sm-10">
            @Model.Role
        </dd>

        <dt class="col-sm-2">
            Auth Provider
        </dt>
        <dd class="col-sm-10">
            @Model.AuthProvider
        </dd>

    </dl>

    <form asp-area="Admin"
          asp-controller="User"
          asp-action="Delete"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="AccountId" />

        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>

    </form>
</div>