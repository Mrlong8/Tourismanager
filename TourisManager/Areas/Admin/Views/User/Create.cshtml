@model TourisManager.Core.Entities.Account

@{
    ViewData["Title"] = "Thêm người dùng mới";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<div class="container-fluid py-4" style="max-width: 900px;">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-plus-fill me-2"></i>Thêm người dùng mới
            </h3>
            <p class="text-muted mb-0 small">Tạo tài khoản và phân quyền người dùng trong hệ thống</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fs-6">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <!-- Username -->
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-semibold">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                            <input asp-for="Username" class="form-control border-start-0 rounded-end-3" placeholder="Nhập username..." required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Họ tên -->
                  
<div class="col-md-6">
    <label asp-for="Name" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-card-heading text-muted"></i></span>
        <input asp-for="Name" class="form-control border-start-0 rounded-end-3" placeholder="Ví dụ: Nguyễn Văn A" required />
    </div>
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" type="email" class="form-control border-start-0 rounded-end-3" placeholder="name@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0 rounded-end-3" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Role -->
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold">Vai trò (Role)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock text-muted"></i></span>
                            <select asp-for="Role" class="form-select border-start-0 rounded-end-3">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                                <option value="Seller">Seller</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <!-- Auth Provider -->
                    <div class="col-md-6">
                        <label asp-for="AuthProvider" class="form-label fw-semibold">Phương thức xác thực</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            <select asp-for="AuthProvider" class="form-select border-start-0 rounded-end-3">
                                <option value="Local">Local</option>
                                <option value="Google">Google</option>
                            </select>
                        </div>
                        <span asp-validation-for="AuthProvider" class="text-danger small"></span>
                    </div>

                    <!-- Nút bấm -->
                    <div class="col-12 pt-3 mt-4 border-top d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-light text-secondary border px-4 rounded-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-3 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i>Lưu tài khoản
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}