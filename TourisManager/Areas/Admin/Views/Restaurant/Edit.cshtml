@model TourisManager.Core.Entities.Restaurant

@{
    ViewData["Title"] = "Sửa Nhà hàng";
}

<h2>Chỉnh sửa Nhà hàng</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="RestaurantId" />
    <input type="hidden" asp-for="CreateBy" />
    <input type="hidden" asp-for="CategoryId" />

    <div class="form-group">
        <label>Mã nhà hàng</label>
        <input asp-for="RestaurantId" class="form-control" disabled />
    </div>
    <div class="form-group">
        <label>Tên nhà hàng</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Mô tả</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label>Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="form-group">
        <label>Vĩ độ (Latitude)</label>
        <input asp-for="Latitude" type="number" step="any" class="form-control" />
    </div>
    <div class="form-group">
        <label>Kinh độ (Longitude)</label>
        <input asp-for="Longitude" type="number" step="any" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>