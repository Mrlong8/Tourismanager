@model IEnumerable<TourisManager.Core.Entities.Restaurant>
@{
    ViewData["Title"] = "Quản lý Nhà hàng";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-shop me-2"></i>Quản lý Nhà hàng
            </h3>
            <p class="text-muted small mb-0">Danh sách các nhà hàng & quán ăn đối tác</p>
        </div>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm nhà hàng
        </a>
    </div>

    <!-- Restaurant Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <!-- Icon Placeholder thay cho ảnh -->
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 160px;">
                            <i class="bi bi-shop text-success display-4"></i>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-2">@item.Name</h5>
                            <p class="card-text text-muted small flex-grow-1 mb-2">
                                <i class="bi bi-geo-alt me-1 text-danger"></i>@(string.IsNullOrEmpty(item.Address) ? "Chưa cập nhật địa chỉ" : item.Address)
                            </p>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-secondary small text-truncate mb-3">@item.Description</p>
                            }

                            <!-- Action Buttons -->
                            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="badge bg-light text-dark fw-normal border">
                                    <i class="bi bi-person me-1"></i>@item.CreateBy
                                </span>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.RestaurantId" class="btn btn-light text-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.RestaurantId" class="btn btn-light text-info" title="Xem"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.RestaurantId" class="btn btn-light text-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-shop-window fs-1 d-block mb-2"></i>
                Chưa có nhà hàng nào được đăng ký.
            </div>
        }
    </div>
</div>