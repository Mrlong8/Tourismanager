@model TourisManager.Core.Entities.Restaurant

@{
    ViewData["Title"] = "Xóa Nhà hàng";
}

<h2>Xác nhận xóa Nhà hàng</h2>

<div>
    <h4>Bạn có chắc chắn muốn xóa nhà hàng này?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Mã nhà hàng:</dt>
        <dd class="col-sm-10">@Model.RestaurantId</dd>

        <dt class="col-sm-2">Tên nhà hàng:</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Địa chỉ:</dt>
        <dd class="col-sm-10">@Model.Address</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="RestaurantId" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>