@model TourisManager.Core.Entities.Restaurant

@{
    ViewData["Title"] = "Thêm Nhà hàng mới";
}

<h2>Thêm Nhà hàng mới</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Tên nhà hàng</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Mô tả</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label>Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="form-group">
        <label>Vĩ độ (Latitude)</label>
        <input asp-for="Latitude" type="number" step="any" class="form-control" value="0" />
    </div>
    <div class="form-group">
        <label>Kinh độ (Longitude)</label>
        <input asp-for="Longitude" type="number" step="any" class="form-control" value="0" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Thêm mới</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>