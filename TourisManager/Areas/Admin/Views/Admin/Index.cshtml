@{
    ViewData["Title"] = "Trang Quản Trị Admin";
    Layout = "MyLayout";
}

<div class="admin-dashboard container-fluid py-4">

    <!-- TIÊU ĐỀ -->
    <div class="dashboard-header mb-4">
        <h2 class="dashboard-title">
            <i class="bi bi-speedometer2 me-2"></i>
            BẢNG QUẢN TRỊ HỆ THỐNG
        </h2>

        <p class="dashboard-subtitle">
            Tổng quan và thống kê hoạt động của hệ thống TourisManager
        </p>
    </div>

    <!-- CÁC THẺ QUẢN LÝ -->
    <div class="row g-4 mb-4">

        <!-- QUẢN LÝ USER -->
        <div class="col-12 col-md-6">
            <div class="dashboard-card h-100">
                <div class="dashboard-card-body">

                    <div class="dashboard-icon user-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="dashboard-card-content">
                        <h4>Quản lý User</h4>

                        <p class="dashboard-description">
                            Tổng số tài khoản
                        </p>

                        <div class="dashboard-number">
                            @(ViewBag.TotalUsers ?? 0)
                        </div>

                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Index"
                           class="dashboard-button">
                            Vào quản lý User
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- QUẢN LÝ LOCATION -->
        <div class="col-12 col-md-6">
            <div class="dashboard-card h-100">
                <div class="dashboard-card-body">

                    <div class="dashboard-icon location-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <div class="dashboard-card-content">
                        <h4>Quản lý Địa điểm</h4>

                        <p class="dashboard-description">
                            Tổng số địa điểm
                        </p>

                        <div class="dashboard-number">
                            @(ViewBag.TotalLocations ?? 0)
                        </div>

                        <a asp-area="Admin"
                           asp-controller="Location"
                           asp-action="Index"
                           class="dashboard-button">
                            Vào quản lý Location
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- BIỂU ĐỒ THỐNG KÊ -->
    <div class="row g-4">

        <!-- USER THEO VAI TRÒ -->
        <div class="col-12 col-xl-6">
            <div class="chart-card h-100">

                <div class="chart-card-header">
                    <h4>
                        <i class="bi bi-bar-chart-line-fill me-2"></i>
                        Thống kê tài khoản theo vai trò
                    </h4>

                    <p>
                        Số lượng tài khoản theo từng vai trò
                    </p>
                </div>

                <div class="chart-card-body">

                    <div class="chart-container horizontal-chart"
                         id="usersChartContainer">

                        <canvas id="usersByRoleChart"></canvas>

                    </div>

                    <div class="chart-empty" id="usersChartEmpty" hidden>
                        <i class="bi bi-bar-chart"></i>
                        <p>Chưa có dữ liệu thống kê tài khoản.</p>
                    </div>

                </div>

            </div>
        </div>

        <!-- LOCATION THEO KHU VỰC -->
        <div class="col-12 col-xl-6">
            <div class="chart-card h-100">

                <div class="chart-card-header">
                    <h4>
                        <i class="bi bi-geo-fill me-2"></i>
                        Thống kê địa điểm theo khu vực
                    </h4>

                    <p>
                        Số lượng địa điểm theo từng khu vực
                    </p>
                </div>

                <div class="chart-card-body">

                    <div class="chart-container vertical-chart"
                         id="locationsChartContainer">

                        <canvas id="locationsByAreaChart"></canvas>

                    </div>

                    <div class="chart-empty" id="locationsChartEmpty" hidden>
                        <i class="bi bi-bar-chart"></i>
                        <p>Chưa có dữ liệu thống kê địa điểm.</p>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>

<!-- DỮ LIỆU BIỂU ĐỒ ĐƯỢC TRUYỀN TỪ CONTROLLER -->
<script type="application/json" id="dashboard-data">
    {
        "usersByRole": @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.UsersByRole ?? new Dictionary<string, int>()
                        )
                ),

        "locationsByArea": @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.LocationsByArea ?? new Dictionary<string, int>()
                        )
                )
    }
</script>

<!-- THƯ VIỆN VÀ FILE JAVASCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
<script src="~/js/Admin/dashboard.js" asp-append-version="true" defer></script>

<!-- FILE CSS -->
<link rel="stylesheet" href="~/css/Admin/dashboard.css" asp-append-version="true" />