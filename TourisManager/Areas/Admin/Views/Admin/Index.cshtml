@using TourisManager.Areas.Admin.Models
@using System.Collections.Generic
@using System.Globalization

@{
    ViewData["Title"] = "Trang Quản Trị Admin";
    Layout = "MyLayout";

    var usersByRole =
        ViewBag.UsersByRole as Dictionary<string, int>
        ?? new Dictionary<string, int>();

    var locationsByArea =
    ViewBag.LocationsByArea as Dictionary<string, int>
    ?? new Dictionary<string, int>();

    int totalUsers = ViewBag.TotalUsers ?? 0;
}

<div class="container py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-success display-6 mb-2">
            BẢNG QUẢN TRỊ HỆ THỐNG
        </h2>
    </div>

    <!-- Các thẻ quản lý hiện tại: GIỮ NGUYÊN -->
    <div class="row g-4 justify-content-center">

        <!-- Card 1: Quản lý User -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-3 transition-hover">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                         style="width: 75px; height: 75px;">
                        <i class="bi bi-people-fill fs-1"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">Quản lý User</h4>

                    <p class="text-muted mb-4">
                        Tổng số tài khoản:
                        <strong class="text-success fs-5">@ViewBag.TotalUsers</strong>
                    </p>

                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       class="btn btn-success mt-auto w-100 rounded-pill py-2 fw-semibold shadow-sm">
                        Vào quản lý User
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2: Quản lý Location -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-3 transition-hover">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                         style="width: 75px; height: 75px;">
                        <i class="bi bi-geo-alt-fill fs-1"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">Quản lý Địa điểm</h4>

                    <p class="text-muted mb-4">
                        Tổng số địa điểm:
                        <strong class="text-success fs-5">@ViewBag.TotalLocations</strong>
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Location"
                       asp-action="Index"
                       class="btn btn-success mt-auto w-100 rounded-pill py-2 fw-semibold shadow-sm">
                        Vào quản lý Location
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 3: Quản lý Restaurant
             Giữ nguyên trạng thái comment như code ban đầu. -->
        @*
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-3 transition-hover">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                         style="width: 75px; height: 75px;">
                        <i class="bi bi-shop fs-1"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">Quản lý Nhà hàng</h4>

                    <p class="text-muted mb-4">
                        Tổng số nhà hàng:
                        <strong class="text-success fs-5">@ViewBag.TotalRestaurants</strong>
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Restaurant"
                       asp-action="Index"
                       class="btn btn-success mt-auto w-100 rounded-pill py-2 fw-semibold shadow-sm">
                        Vào quản lý Restaurant
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        *@

    </div>

    <!-- ====================================== -->
    <!-- THỐNG KÊ CHI TIẾT 1: NGƯỜI DÙNG -->
    <!-- ====================================== -->
    <div class="row g-4 mt-4">
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h4 class="fw-bold text-success mb-4">
                        <i class="bi bi-people-fill me-2"></i>
                        Thống kê người dùng theo vai trò
                    </h4>

                    @{
                        var roleNames = new[]
                        {
                            new { Key = "User", Label = "Khách hàng", Icon = "bi-person-fill" },
                            new { Key = "Seller", Label = "Người bán", Icon = "bi-shop" },
                            new { Key = "Admin", Label = "Quản trị viên", Icon = "bi-shield-check" }
                        };
                    }

                    @foreach (var role in roleNames)
                    {
                        int count = usersByRole.TryGetValue(role.Key, out int value)
                            ? value
                            : 0;

                        double percent = totalUsers > 0
                            ? (double)count / totalUsers * 100
                            : 0;

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>
                                    <i class="bi @role.Icon me-2 text-success"></i>
                                    @role.Label
                                </span>

                                <strong class="text-success">
                                    @count tài khoản
                                </strong>
                            </div>

                            <div class="progress rounded-pill"
                                 style="height: 10px;"
                                 aria-label="Tỷ lệ @role.Label">
                                <div class="progress-bar bg-success rounded-pill"
                                     role="progressbar"
                                     style="width: @(percent.ToString("0.##", CultureInfo.InvariantCulture))%"
                                     aria-valuenow="@count"
                                     aria-valuemin="0"
                                     aria-valuemax="@totalUsers">
                                </div>
                            </div>

                            <small class="text-muted">
                                @percent.ToString("0.##")% tổng số tài khoản
                            </small>
                        </div>
                    }

                    <div class="border-top pt-3 d-flex justify-content-between">
                        <span class="fw-semibold">Tổng cộng</span>
                        <strong class="text-success">@totalUsers tài khoản</strong>
                    </div>

                </div>
            </div>
        </div>

        <!-- ====================================== -->
        <!-- THỐNG KÊ CHI TIẾT 2: ĐỊA ĐIỂM -->
        <!-- ====================================== -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h4 class="fw-bold text-success mb-4">
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        Thống kê địa điểm theo khu vực
                    </h4>

                    @if (locationsByArea.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Khu vực</th>
                                        <th class="text-end">Số địa điểm</th>
                                        <th style="min-width: 100px;">Tỷ lệ</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var area in locationsByArea)
                                    {
                                        double locationPercent =
                                            (int)(ViewBag.TotalLocations ?? 0) > 0
                                            ? (double)area.Value
                                                / (int)ViewBag.TotalLocations * 100
                                            : 0;

                                        <tr>
                                            <td>
                                                <i class="bi bi-geo-alt text-success me-1"></i>
                                                @area.Key
                                            </td>

                                            <td class="text-end">
                                                <span class="badge bg-success rounded-pill">
                                                    @area.Value
                                                </span>
                                            </td>

                                            <td>
                                                <div class="progress rounded-pill"
                                                     style="height: 8px;">
                                                    <div class="progress-bar bg-success rounded-pill"
                                                         role="progressbar"
                                                         style="width: @(locationPercent.ToString("0.##", CultureInfo.InvariantCulture))%"
                                                         aria-valuenow="@area.Value"
                                                         aria-valuemin="0"
                                                         aria-valuemax="@ViewBag.TotalLocations">
                                                    </div>
                                                </div>

                                                <small class="text-muted">
                                                    @locationPercent.ToString("0.##")%
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot class="table-light">
                                    <tr>
                                        <th>Tổng cộng</th>
                                        <th class="text-end">
                                            @ViewBag.TotalLocations
                                        </th>
                                        <th>100%</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                            Chưa có dữ liệu khu vực.
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(25, 135, 84, 0.15) !important;
    }
</style>
