@using TourisManager.Helpers;
@using TourisManager.Core.Entities;
@model PaginatedList<Location>

@{
    ViewData["Title"] = "Quản lý Địa điểm nhà hàng";
    Layout = "SidebarAdmin";
}

<div class="container-fluid py-4">
    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <a asp-area="Admin" asp-controller="Location" asp-action="Index" class="text-success text-decoration-none">
                    <i class="bi bi-geo-alt-fill me-2"></i>Danh sách nhà hàng và quán ăn trong hệ thống
                </a>
            </h3>
            <p class="text-muted small mb-0">Danh sách nhà hàng và quán ăn trong hệ thống</p>
        </div>
        <a asp-area="Admin" asp-controller="Location" asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm địa điểm mới
        </a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-area="Admin" asp-controller="Location" asp-action="Index" class="row g-2 mb-0 align-items-center">
                <!-- 1. Ô tìm kiếm theo tên/địa chỉ -->
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.CurrentSearch"
                               class="form-control border-start-0 ps-0"
                               placeholder="Tìm kiếm địa điểm..." />
                    </div>
                </div>

                <!-- 2. Dropdown Lọc theo Danh mục -->
                <div class="col-md-4">
                    <select name="categoryId" class="form-select">
                        <option value="">-- Tất cả danh mục --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.CategoryId" 
                                        selected="@(cat.CategoryId.ToString() == Convert.ToString(ViewBag.CurrentCategory) ? "selected" : null)">
                                    @cat.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- 3. Nút Lọc và Nút Xóa lọc -->
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-success w-100 fw-semibold">
                        Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || !string.IsNullOrEmpty(Convert.ToString(ViewBag.CurrentCategory)))
                    {
                        <a asp-area="Admin" asp-controller="Location" asp-action="Index" class="btn btn-light text-secondary border" title="Xóa bộ lọc">
                            <i class="bi bi-x-circle"></i>
                        </a>    
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table Data Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase fs-7 border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Hình ảnh</th>
                            <th>Tên địa điểm</th>
                            <th>Địa chỉ</th>
                            <th>Danh mục</th>
                            <th class="text-center" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">

                                        <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl)
                                             ? "/Image/Upload/avatadefault.jpg"
                                             : item.ImageUrl)"
                                             onerror="this.onerror=null; this.src='/Image/Upload/avatadefault.jpg';"
                                             class="rounded-3 object-fit-cover"
                                             width="50"
                                             height="50"
                                             alt="@item.Name" />

                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        <small class="text-muted">ID: @item.LocationId</small>
                                    </td>
                                    <td class="text-muted fs-7">
                                        <i class="bi bi-geo-alt me-1"></i>@item.Address
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            @(ViewBag.Categories == null
                                                ? "Chưa phân loại"
                                                : ((IEnumerable<TourisManager.Core.Entities.Category>)ViewBag.Categories)
                                                    .FirstOrDefault(c => c.CategoryId == item.CategoryId)?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                        <td class="text-center pe-4">
                                            <div class="btn-group btn-group-sm" role="group">
                                            <a asp-area="Admin" asp-controller="Location" asp-action="Edit" asp-route-id="@item.LocationId" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Location" asp-action="Details" asp-route-id="@item.LocationId" class="btn btn-outline-info" title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Location" asp-action="Delete" asp-route-id="@item.LocationId" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy địa điểm nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        
           
              <!-- Phân trang Location -->
        @if (Model != null)
        {
            <div class="location-pagination-footer">

                <!-- Thông tin trang -->
                <div class="location-pagination-info">
                    Hiển thị trang
                    <strong>@Model.PageIndex</strong> /
                    <strong>@Model.TotalPages</strong>
                    (Tổng <strong>@Model.TotalCount</strong> địa điểm)
                </div>

                <!-- Các nút phân trang -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Phân trang địa điểm">
                        <ul class="pagination location-pagination mb-0">

                            <!-- Trước -->
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link location-prev-next"
                                   asp-area="Admin"
                                   asp-controller="Location"
                                   asp-action="Index"
                                   asp-route-pageIndex="@(Model.PageIndex - 1)"
                                   asp-route-searchString="@ViewBag.CurrentSearch"
                                   asp-route-categoryId="@ViewBag.CurrentCategory">
                                    <i class="bi bi-chevron-left"></i> Trước
                                </a>
                            </li>

                            <!-- Các số trang -->
                            @{
                                int startPage = Math.Max(1, Model.PageIndex - 1);
                                int endPage = Math.Min(Model.TotalPages, startPage + 2);

                                if (endPage - startPage < 2)
                                {
                                    startPage = Math.Max(1, endPage - 2);
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link location-page-number"
                                       asp-area="Admin"
                                       asp-controller="Location"
                                       asp-action="Index"
                                       asp-route-pageIndex="@i"
                                       asp-route-searchString="@ViewBag.CurrentSearch"
                                       asp-route-categoryId="@ViewBag.CurrentCategory">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                <li class="page-item disabled">
                                    <span class="location-ellipsis">...</span>
                                </li>
                            }

                            <!-- Sau -->
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link location-prev-next"
                                   asp-area="Admin"
                                   asp-controller="Location"
                                   asp-action="Index"
                                   asp-route-pageIndex="@(Model.PageIndex + 1)"
                                   asp-route-searchString="@ViewBag.CurrentSearch"
                                   asp-route-categoryId="@ViewBag.CurrentCategory">
                                    Sau <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>
                }
            </div>
        }



        
    </div>
</div>