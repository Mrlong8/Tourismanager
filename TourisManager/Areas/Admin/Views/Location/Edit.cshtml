@model TourisManager.Core.Entities.Location

@{
    ViewData["Title"] = "Sửa Địa điểm";
}

<h2>Chỉnh sửa Địa điểm</h2>

<form asp-action="Edit" method="post">
    <!-- Thẻ ẩn lưu giữ khóa chính và thuộc tính khóa ngoại -->
    <input type="hidden" asp-for="LocationId" />
    <input type="hidden" asp-for="CreateBy" />
    <input type="hidden" asp-for="CategoryId" />

    <div class="form-group">
        <label>Tên địa điểm</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Mô tả</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="form-group">
        <label>Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>