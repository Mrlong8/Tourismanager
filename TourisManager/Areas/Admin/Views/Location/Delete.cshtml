@model TourisManager.Core.Entities.Location

@{
    ViewData["Title"] = "Xác nhận xóa Địa điểm";
}

<!-- Link Bootstrap 5 & Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<div class="container-fluid py-4" style="max-width: 1100px;">
    <!-- Header Page -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-danger mb-1">
                <i class="bi bi-trash-fill me-2"></i>Xác nhận xóa Địa điểm
            </h3>
            <p class="text-muted mb-0 small">Hành động này sẽ xóa địa điểm khỏi hệ thống và không thể hoàn tác</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fs-6">
            <i class="bi bi-arrow-left me-1"></i>Hủy & Quay lại
        </a>
    </div>

    <!-- Main Alert Card -->
    <div class="card border-danger-subtle shadow-sm rounded-4 overflow-hidden">
        <!-- Banner cảnh báo -->
        <div class="bg-danger-subtle text-danger px-4 py-3 d-flex align-items-center gap-2 border-bottom border-danger-subtle">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span class="fw-semibold">Bạn có chắc chắn muốn xóa địa điểm này không?</span>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-4 align-items-center">
                <!-- Cột trái: Ảnh địa điểm -->
                <div class="col-lg-5 text-center pe-lg-4 border-end">
                    <div class="position-relative d-inline-block w-100">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/Image/Upload/avatadefault.jpg" : Model.ImageUrl)" 
                             onerror="this.onerror=null; this.src='/Image/Upload/avatadefault.jpg';"
                             class="img-fluid rounded-4 shadow-sm object-fit-cover w-100 border" 
                             style="max-height: 280px;" 
                             alt="@Model.Name" />
                    </div>
                </div>

                <!-- Cột phải: Thông tin địa điểm sẽ xóa -->
                <div class="col-lg-7">
                    <!-- Badge ID -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-secondary-subtle text-secondary border fw-bold px-3 py-2 rounded-pill fs-6">
                            ID: @Model.LocationId
                        </span>
                    </div>

                    <!-- Tên địa điểm -->
                    <h3 class="fw-bold text-dark mb-3">@Model.Name</h3>

                    <!-- Địa chỉ -->
                    <div class="mb-3 d-flex align-items-start gap-2 text-secondary">
                        <i class="bi bi-geo-alt-fill text-danger fs-5 flex-shrink-0"></i>
                        <span class="fs-6 fw-medium">
                            @(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật địa chỉ" : Model.Address)
                        </span>
                    </div>

                    <!-- Mô tả -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">Mô tả:</h6>
                            <p class="text-muted small bg-light p-3 rounded-3 border mb-0">
                                @Model.Description
                            </p>
                        </div>
                    }

                    <!-- Form xác nhận xóa -->
                    <form asp-action="Delete" method="post" class="pt-3 border-top">
                        <input type="hidden" asp-for="LocationId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4 rounded-3 fw-semibold shadow-sm">
                                <i class="bi bi-trash me-1"></i>Xác nhận Xóa
                            </button>
                            <a asp-action="Index" class="btn btn-light text-secondary border px-4 rounded-3">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>